{
    "label"   : "lock",
    "action"  : "hyprlock --grace 5",
    "text"    : "󰌾   Lock",
    "keybind" : "l"
}
{
    "label"   : "logout",
    "action"  : "hyprctl dispatch 'hl.dsp.exit()'",
    "text"    : "󰍃   Logout",
    "keybind" : "e"
}
{
    "label"   : "suspend",
    "action"  : "systemctl suspend",
    "text"    : "󰒲   Suspend",
    "keybind" : "u"
}
{
    "label"   : "reboot",
    "action"  : "systemctl reboot",
    "text"    : "󰜉   Restart",
    "keybind" : "r"
}
{
    "label"   : "shutdown",
    "action"  : "systemctl poweroff",
    "text"    : "󰐥   Shutdown",
    "keybind" : "s"
}

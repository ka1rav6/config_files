{
  /* =========================================================
     HOVER INFORMATION (ALLOWED)
     ========================================================= */
  "editor.hover.enabled": "on",
  "editor.parameterHints.enabled": true,

  /* =========================================================
     DISABLE PREDICTIVE INTELLISENSE
     ========================================================= */
   "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": false
   },
  "editor.inlineSuggest.enabled": true, // change this

  /* =========================================================
     ACCEPTANCE KEYS
     ========================================================= */
  "editor.acceptSuggestionOnTab": "smart",
  "editor.acceptSuggestionOnEnter": "off",

  /* =========================================================
     SNIPPETS
     ========================================================= */
   "editor.snippetSuggestions": "inline",
   "editor.tabCompletion": "on",
   "editor.suggestOnTriggerCharacters": true,
   "editor.wordBasedSuggestions": "allDocuments",

  /* =========================================================
     QUIET EDITOR UI
     ========================================================= */
  "editor.lightbulb.enabled": "off",
  "editor.codeLens": false,

  /* =========================================================
     GENERAL EDITOR BEHAVIOR
     ========================================================= */
  "editor.wordWrap": "on",
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.renderWhitespace": "selection",

  /* =========================================================
     FILES & WORKBENCH
     ========================================================= */
  "files.autoSave": "afterDelay",
  "workbench.editor.empty.hint": "hidden",

  /* =========================================================
     TERMINAL
     ========================================================= */
  "terminal.integrated.enableMultiLinePasteWarning": "never",

  /* =========================================================
     C / C++ CONFIGURATION
     ========================================================= */
  "C_Cpp.default.compilerPath": "C:\\MinGW\\bin\\gcc.exe",

  /* =========================================================
     SECURITY / WSL
     ========================================================= */
  "security.allowedUNCHosts": [
    "wsl.localhost"
  ],

  /* =========================================================
     PEACOCK
     ========================================================= */
  "peacock.favoriteColors": [
   {
      "name": "Craxy Purple",
      "value": "#120B0E"
   },
   {
      "name": "Red (Black Bean)",
      "value": "#3D0302"
   },
   {
      "name": "Cool Emerald",
      "value": "#1D2E28"
   },
   {
      "name": "Mandalorian Blue",
      "value": "#1857a4"
   },
   {
      "name": "Node Green",
      "value": "#215732"
   },
   {
      "name": "React Blue",
      "value": "#61dafb"
   },
   {
      "name": "Something Different",
      "value": "#832561"
   },
   {
      "name": "Svelte Orange",
      "value": "#ff3d00"
   },
   {
      "name": "Vue Green",
      "value": "#42b883"
   },
   {
      "name": "Perfect Red",
      "value": "#46000D"
   },
   {
      "name": "Perfect Blue",
      "value": "#061831"
   },
   {
      "name": "Perfect Green",
      "value": "#001E1E"
   },
   {
      "name": "Perfect Purple",
      "value": "#301934"
   }
],

  /* =========================================================
     INDENTATION RULES
     ========================================================= */

  "editor.tabSize": 4,
  "editor.insertSpaces": true,

  "[c]": { "editor.tabSize": 4 },
  "[cpp]": { "editor.tabSize": 4 },
  "[python]": { "editor.tabSize": 4 },

  "[html]": { "editor.tabSize": 2 },
  "[css]": { "editor.tabSize": 2 },
  "[javascript]": { "editor.tabSize": 2 },

"liveServer.settings.donotVerifyTags": true,
"liveServer.settings.donotShowInfoMsg": true,
"git.enableSmartCommit": true,
"git.confirmSync": false,
"explorer.confirmDelete": false,
"gitlens.ai.model": "vscode",
"gitlens.ai.vscode.model": "copilot:gpt-4.1",
"python.terminal.useEnvFile": true,
"python.createEnvironment.trigger": "off",
"mdb.mcp.server": "autoStartEnabled",
"python.analysis.typeCheckingMode": "basic",
"explorer.confirmDragAndDrop": false,
"makefile.configureOnOpen": true,
"git.openRepositoryInParentFolders": "never",
"workbench.editorAssociations": {
   "*.copilotmd": "vscode.markdown.preview.editor",
   "*.pdf": "default"
},
"C_Cpp.intelliSenseEngine": "disabled",
"jdk.telemetry.enabled": false
}
#include "board.h"
#include "piece.h"
#include "point.h"

Board* initBoard(){
    Board* board = (Board*)malloc(sizeof(Board));

    board->state = DEFAULT;
    for (int i = 0; i < 8; i++){
        for (int j = 0; j < 8; j ++){
            board->arr[i][j].p = createPoint(i + 1, (char) ('a' + i));

                        board->arr[i][j].type = KNIGHT;
                        break;
                    case 'c':
                        col = sq_pnt.row == 1 ? WHITE : BLACK;
                        board->arr[i][j].piecePtr = initPiece(BISHOP, col);
                        board->arr[i][j].type = BISHOP;
                        break;
                    case 'b':
                        col = sq_pnt.row == 1 ? WHITE : BLACK;
                        board->arr[i][j].piecePtr = initPiece(KNIGHT, col);
                        board->arr[i][j].type = KNIGHT;
                        break;
                    case 'b':
                        col = sq_pnt.row == 1 ? WHITE : BLACK;
                        board->arr[i][j].piecePtr = initPiece(KNIGHT, col);
                        board->arr[i][j].type = KNIGHT;
                        break;
                    case 'b':
                        col = sq_pnt.row == 1 ? WHITE : BLACK;
                        board->arr[i][j].piecePtr = initPiece(KNIGHT, col);
                        board->arr[i][j].type = KNIGHT;
                        break;
                    case 'b':
                        col = sq_pnt.row == 1 ? WHITE : BLACK;
                        board->arr[i][j].piecePtr = initPiece(KNIGHT, col);
                        board->arr[i][j].type = KNIGHT;
                        break;
                    case 'b':
                        col = sq_pnt.row == 1 ? WHITE : BLACK;
                        board->arr[i][j].piecePtr = initPiece(KNIGHT, col);
                        board->arr[i][j].type = KNIGHT;
                        break;
                }
            }
        }
    }
    return board;
}
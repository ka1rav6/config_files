"""Integration tests for comments: create, list, edit, delete, report."""
from app.models.user import UserRole
from tests.helpers import auth_headers


def _publish_post(client, headers: dict, title: str = "A discussion post") -> str:
    """Create a draft via the API and publish it; return its public_id."""
    created = client.post(
        "/api/v1/posts", json={"title": title, "content": "Some body"}, headers=headers
    ).json()
    client.put(f"/api/v1/posts/{created['public_id']}/publish", headers=headers)
    return created["public_id"]


# --- creating comments -------------------------------------------------------


def test_anonymous_cannot_comment(client, session_factory):
    _, author_headers = auth_headers(
        session_factory, role=UserRole.AUTHOR, username="author", email="author@x.com"
    )
    pid = _publish_post(client, author_headers)
    response = client.post(f"/api/v1/posts/{pid}/comments", json={"content": "hi"})
    assert response.status_code == 401


def test_reader_can_comment_and_see_it_listed(client, session_factory):
    _, author_headers = auth_headers(
        session_factory, role=UserRole.AUTHOR, username="author", email="author@x.com"
    )
    pid = _publish_post(client, author_headers)

    user, headers = auth_headers(
        session_factory, role=UserRole.USER, username="reader", email="reader@x.com"
    )
    created = client.post(
        f"/api/v1/posts/{pid}/comments", json={"content": "Great article!"}, headers=headers
    )
    assert created.status_code == 201
    body = created.json()
    assert body["author"]["username"] == user.username
    assert body["content"] == "Great article!"

    # The comment appears in the public list, with the author's name.
    listed = client.get(f"/api/v1/posts/{pid}/comments")
    assert listed.status_code == 200
    items = listed.json()
    assert len(items) == 1
    assert items[0]["public_id"] == body["public_id"]
    assert items[0]["status"] == "VISIBLE"


def test_comments_are_listed_oldest_first(client, session_factory):
    _, author_headers = auth_headers(
        session_factory, role=UserRole.AUTHOR, username="author", email="author@x.com"
    )
    pid = _publish_post(client, author_headers)

    _, first = auth_headers(session_factory, role=UserRole.USER, username="c1", email="c1@x.com")
    _, second = auth_headers(
        session_factory, role=UserRole.USER, username="c2", email="c2@x.com"
    )
    client.post(f"/api/v1/posts/{pid}/comments", json={"content": "First"}, headers=first)
    client.post(f"/api/v1/posts/{pid}/comments", json={"content": "Second"}, headers=second)

    items = client.get(f"/api/v1/posts/{pid}/comments").json()
    assert [i["content"] for i in items] == ["First", "Second"]


def test_cannot_comment_on_a_private_draft(client, session_factory):
    _, author_headers = auth_headers(
        session_factory, role=UserRole.AUTHOR, username="author", email="author@x.com"
    )
    draft = client.post("/api/v1/posts", json={"title": "Secret"}, headers=author_headers).json()

    _, headers = auth_headers(
        session_factory, role=UserRole.USER, username="reader", email="reader@x.com"
    )
    # Strangers cannot even see the draft exists -> 404 (no info leak).
    response = client.post(
        f"/api/v1/posts/{draft['public_id']}/comments", json={"content": "hi"}, headers=headers
    )
    assert response.status_code == 404


def test_empty_comment_is_rejected(client, session_factory):
    _, author_headers = auth_headers(
        session_factory, role=UserRole.AUTHOR, username="author", email="author@x.com"
    )
    pid = _publish_post(client, author_headers)

    _, headers = auth_headers(
        session_factory, role=UserRole.USER, username="reader", email="reader@x.com"
    )
    response = client.post(
        f"/api/v1/posts/{pid}/comments", json={"content": "   "}, headers=headers

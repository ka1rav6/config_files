# --- editing & deleting ------------------------------------------------------


def test_non_owner_cannot_edit_or_delete(client, session_factory):
    _, author_headers = auth_headers(
        session_factory, role=UserRole.AUTHOR, username="author", email="author@x.com"
    )
    pid = _publish_post(client, author_headers)

    _, alice_headers = auth_headers(
        session_factory, role=UserRole.USER, username="alice", email="alice@x.com"
    )
    created = client.post(
        f"/api/v1/posts/{pid}/comments", json={"content": "mine"}, headers=alice_headers
    ).json()

    _, bob_headers = auth_headers(
        session_factory, role=UserRole.USER, username="bob", email="bob@x.com"
    )
    cid = created["public_id"]
    response = client.put(
        f"/api/v1/comments/{cid}", json={"content": "hacked"}, headers=bob_headers
    )
    assert response.status_code == 403
    assert client.delete(f"/api/v1/comments/{cid}", headers=bob_headers).status_code == 403


def test_owner_can_edit_and_delete(client, session_factory):
    _, author_headers = auth_headers(
        session_factory, role=UserRole.AUTHOR, username="author", email="author@x.com"
    )
    pid = _publish_post(client, author_headers)

    _, headers = auth_headers(
        session_factory, role=UserRole.USER, username="reader", email="reader@x.com"
    )
    created = client.post(
        f"/api/v1/posts/{pid}/comments", json={"content": "before"}, headers=headers
    ).json()
    cid = created["public_id"]

    updated = client.put(f"/api/v1/comments/{cid}", json={"content": "after"}, headers=headers)
    assert updated.status_code == 200
    assert updated.json()["content"] == "after"

    assert client.delete(f"/api/v1/comments/{cid}", headers=headers).status_code == 204
    assert client.get(f"/api/v1/posts/{pid}/comments").json() == []


# --- reporting & moderation --------------------------------------------------


def test_user_cannot_report_own_comment(client, session_factory):
    _, author_headers = auth_headers(
        session_factory, role=UserRole.AUTHOR, username="author", email="author@x.com"
    )
    pid = _publish_post(client, author_headers)

    _, headers = auth_headers(
        session_factory, role=UserRole.USER, username="reader", email="reader@x.com"
    )
    created = client.post(
        f"/api/v1/posts/{pid}/comments", json={"content": "mine"}, headers=headers
    ).json()
    assert (
        client.post(f"/api/v1/comments/{created['public_id']}/report", headers=headers).status_code
        == 422
    )


def test_reported_comment_disappears_from_public_list(client, session_factory):
    _, author_headers = auth_headers(
        session_factory, role=UserRole.AUTHOR, username="author", email="author@x.com"
    )
    pid = _publish_post(client, author_headers)

    _, alice_headers = auth_headers(
        session_factory, role=UserRole.USER, username="alice", email="alice@x.com"
    )
    created = client.post(
        f"/api/v1/posts/{pid}/comments", json={"content": "spam!"}, headers=alice_headers
    ).json()

    # Another reader reports it.
    _, reporter_headers = auth_headers(
        session_factory, role=UserRole.USER, username="reporter", email="rep@x.com"
    )
    reported = client.post(
        f"/api/v1/comments/{created['public_id']}/report", headers=reporter_headers
    )
    assert reported.status_code == 200
    assert reported.json()["status"] == "REPORTED"

    # Public list now hides it; admins still see it.
    assert client.get(f"/api/v1/posts/{pid}/comments").json() == []

    _, admin_headers = auth_headers(
        session_factory, role=UserRole.ADMIN, username="admin", email="admin@x.com"
    )
    admin_list = client.get(f"/api/v1/posts/{pid}/comments", headers=admin_headers)
    assert admin_list.status_code == 200
    assert len(admin_list.json()) == 1
    assert admin_list.json()[0]["status"] == "REPORTED"


def test_admin_can_delete_any_comment(client, session_factory):
    _, author_headers = auth_headers(
        session_factory, role=UserRole.AUTHOR, username="author", email="author@x.com"
    )
    pid = _publish_post(client, author_headers)

    _, user_headers = auth_headers(session_factory, role=UserRole.USER)
    created = client.post(
        f"/api/v1/posts/{pid}/comments", json={"content": "bad"}, headers=user_headers
    ).json()

    _, admin_headers = auth_headers(
        session_factory, role=UserRole.ADMIN, username="admin", email="admin@x.com"
    )
    response = client.delete(f"/api/v1/comments/{created['public_id']}", headers=admin_headers)
    assert response.status_code == 204
    assert client.get(f"/api/v1/posts/{pid}/comments").json() == []

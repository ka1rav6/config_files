// `hyprtodo-cli` — the headless entry point from design doc Milestone 2.
// Talks to the same SQLite database as the GUI, so `hyprtodo-cli add` and
// the Tauri window stay in sync without any IPC between them.

use clap::{Parser, Subcommand};
use hyprtodo::db;
use hyprtodo::tasks::{self, Criticality, NewTask, Status, TaskFilter};

#[derive(Parser)]
#[command(name = "hyprtodo", about = "Fast, keyboard-first task manager for Hyprland")]
struct Cli {
    #[command(subcommand)]
    command: Command,
}

#[derive(Subcommand)]
enum Command {
    /// Add a new task
    Add {
        title: Vec<String>,
        #[arg(short, long)]
        category: Option<String>,
        #[arg(short = 'C', long, value_enum)]
        criticality: Option<CriticalityArg>,
        #[arg(short, long)]
        due: Option<String>,
    },
    /// List tasks
    List {
        #[arg(short, long)]
        category: Option<String>,
        /// Include completed tasks
        #[arg(short, long)]
        all: bool,
    },
    /// Mark a task complete by id (or id prefix)
    Done { id: String },
}

#[derive(Clone, clap::ValueEnum)]
enum CriticalityArg {
    Low,
    Normal,
    High,
    Critical,
}

impl From<CriticalityArg> for Criticality {
    fn from(v: CriticalityArg) -> Self {
        match v {
            CriticalityArg::Low => Criticality::Low,
            CriticalityArg::Normal => Criticality::Normal,
            CriticalityArg::High => Criticality::High,
            CriticalityArg::Critical => Criticality::Critical,
        }
    }
}

fn main() -> anyhow::Result<()> {
    let cli = Cli::parse();
    let pool = db::init_pool()?;

    match cli.command {
        Command::Add { title, category, criticality, due } => {
            let title = title.join(" ");
            if title.trim().is_empty() {
                anyhow::bail!("task title cannot be empty");
            }
            let task = tasks::create(
                &pool,
                NewTask {
                    title,
                    description: None,
                    category_id: category,
                    criticality: criticality.map(Into::into),
                    due_at: due,
                    estimated_minutes: None,
                    parent_id: None,
                },
            )?;
            println!("added [{}] {}", &task.id[..8], task.title);
        }
        Command::List { category, all } => {
            let filter = TaskFilter {
                category_id: category,
                status: if all { None } else { Some(Status::Pending) },
                criticality: None,
            };
            let list = tasks::list(&pool, &filter)?;
            if list.is_empty() {
                println!("no tasks");
            }
            for t in list {
                let marker = match t.status {
                    Status::Completed => "x",
                    Status::Archived => "-",
                    Status::Pending => " ",
                };
                let due = t.due_at.map(|d| format!("  (due {d})")).unwrap_or_default();
                println!("[{}] {} {}{}", marker, &t.id[..8], t.title, due);
            }
        }
        Command::Done { id } => {
            // Resolve a short id prefix to a full task id, mirroring how a
            // person would type the first 8 chars printed by `list`.
            let filter = TaskFilter::default();
            let candidates: Vec<_> = tasks::list(&pool, &filter)?
                .into_iter()
                .filter(|t| t.id.starts_with(&id))
                .collect();
            match candidates.as_slice() {
                [] => anyhow::bail!("no task matches id '{id}'"),
                [only] => {
                    tasks::set_status(&pool, &only.id, Status::Completed)?;
                    println!("completed: {}", only.title);
                }
                _ => anyhow::bail!("id '{id}' is ambiguous, use more characters"),
            }
        }
    }
    Ok(())
}

{
    "layer": "top",
    "position": "top",

    "height": 32,

    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "custom/apple",
        "hyprland/workspaces"
    ],

    "modules-center": [],

    "modules-right": [
        "tray",
        "pulseaudio",
        "battery",
        "clock",
        "custom/power"
    ],

    "custom/apple": {
        "format": "",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "format-icons": {
            "1": "1",
            "2": "2",
            "3": "3",
            "4": "4"
        },
        "all-outputs": true,
        "sort-by-number": true,
        "on-click": "activate"
    },

    "tray": {
    "icon-size": 16,
    "spacing": 8
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾"
        ]
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip": false,
        "on-click" : "waycal"
    },
    "custom/power": {
    "format": "⏻",
    "tooltip": "Power",
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
}
}

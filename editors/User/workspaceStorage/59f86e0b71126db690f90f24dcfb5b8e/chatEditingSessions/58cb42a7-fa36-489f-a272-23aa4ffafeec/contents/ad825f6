window {
    margin: 0;
    border: 1px solid #3b4a4d;
    border-radius: 20px;
    background-color: #111719;
    color: #e8efed;
    font-family: "Noto Sans", sans-serif;
    font-size: 15px;
}

#outer-box {
    padding: 24px;
}

#input {
    margin: 0 0 22px;
    padding: 15px 18px;
    border: 1px solid #304144;
    border-radius: 12px;
    background-color: #1b2527;
    color: #f4faf8;
    caret-color: #73d0b0;
}

#input:focus {
    border-color: #73d0b0;
    box-shadow: 0 0 0 1px #73d0b0;
}

#inner-box {
    margin: 0;
}

#scroll {
    margin: 0;
}

#entry {
    min-width: 132px;
    min-height: 116px;
    margin: 5px;
    padding: 14px 8px;
    border: 1px solid transparent;
    border-radius: 14px;
    background-color: transparent;
}

#entry:hover,
#entry:selected {
    border-color: #426d64;
    background-color: #203332;
    color: #ffffff;
}

#entry:selected {
    box-shadow: inset 0 -2px 0 #73d0b0;
}

#img {
    margin: 4px 0 12px;
}

#text {
    color: #dce8e4;
    font-size: 13px;
}

#entry:selected #text {
    color: #ffffff;
}

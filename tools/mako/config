# =============================================================================
# mako — notification daemon
# =============================================================================
# Started at login from ~/.config/hypr/autostart.lua. Everything that calls
# notify-send lands here: the `notify-build` shell function in ~/.zshrc, the
# battery and temperature watchers in ~/.local/bin/system-monitor-notify, and
# ~/.local/bin/now-playing-notify.
#
# Structure: global settings first, then `[criteria]` sections. A criteria
# section overrides the globals for notifications that match it — matching on
# app-name, urgency, category and so on. Later matching sections win.
#
# Reload after editing:  makoctl reload
# Test a notification:   notify-send -a "Build" "title" "body"
# List active:           makoctl list
# Full reference:        man 5 mako
#
# Comments must be on their own line — this parser does not strip a trailing
# `#` from a value.
# =============================================================================

# Newest notification on top. A leading `-` reverses the sort; `+time` would put
# the oldest first.
sort=-time

# Layer-shell layer. "top" sits above normal windows but below fullscreen
# clients, so a notification cannot cover a fullscreen video or presentation.
layer=top

# --- Palette -----------------------------------------------------------------
# Shared with waybar (~/.config/waybar/style.css) and the Hyprland border
# gradient in ~/.config/hypr/looknfeel.lua:
#   bg    rgba(18,20,24,.94)   mint  #8ee3c1
#   amber #f4c47b              coral #ff9b85
# Radius matches the bar's 11px. Change a colour here and change it there too,
# or the desktop stops looking like one design.
background-color=#121418f0
text-color=#f4f7fa
border-color=#8ee3c1

# `over` blends the progress fill on top of the background rather than
# replacing it, so the bar tints the notification instead of blanking it.
# Used by notifications that carry a value, e.g. volume changes.
progress-color=over #1f2d2a

border-size=2
border-radius=11

# --- Timing ------------------------------------------------------------------
# Milliseconds on screen. 5 s is long enough to read a build result without
# lingering.
default-timeout=5000

# 0 = honour each notification's own requested timeout rather than forcing
# default-timeout on everything. Set to 1 to override senders that ask to stay
# on screen indefinitely.
ignore-timeout=0

# --- History -----------------------------------------------------------------
# Keep dismissed notifications so they can be recalled — ~/.local/bin/mako-fzf-history
# pipes this through fzf. Without history=1 a missed notification is gone.
max-history=100
history=1

# --- Mouse -------------------------------------------------------------------
# Left  — run the notification's default action (usually "open the thing")
# Middle— offer the full action list through a wofi menu
# Right — dismiss
on-button-left=invoke-default-action
on-button-middle=exec makoctl menu -n "$id" -- wofi --show dmenu -p 'Action: '
on-button-right=dismiss


# =============================================================================
# Per-application overrides
# =============================================================================

# Critical notifications get the coral border and never expire on their own —
# they must be dismissed. urgency=critical is set by the sender; the battery
# watcher uses it at low charge.
[urgency=critical]
border-color=#ff9b85
default-timeout=0

# Build results from the `notify-build` function in ~/.zshrc. Clicking focuses
# the Ghostty window so you land back on the build output rather than hunting
# for the terminal.
[app-name="Build"]
on-button-left=exec ~/.config/hypr/scripts/focus-window.sh com.mitchellh.ghostty

# Now-playing notifications from ~/.local/bin/now-playing-notify. Clicking
# raises the browser that is playing. Two rules because the window class differs
# between browsers, and focus-window.sh takes several candidate classes.
[app-name="NowPlaying:chromium"]
on-button-left=exec ~/.config/hypr/scripts/focus-window.sh chromium google-chrome chrome

[app-name="NowPlaying:firefox"]
on-button-left=exec ~/.config/hypr/scripts/focus-window.sh firefox

# Status notifications from ~/.local/bin/system-monitor-notify. There is nothing
# to open, so a click just dismisses instead of firing a default action.
[app-name="Battery"]
on-button-left=dismiss

[app-name="Temperature"]
on-button-left=dismiss

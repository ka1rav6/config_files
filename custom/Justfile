DEST := "/media/kairav/PROJECTS/dev/"
EXCLUDES := home_directory() / ".config/rsync/excludes.txt"
BACKUP := home_directory() / ".local/share/config-backup/config_backup.py"
RESTORE := home_directory() / ".local/share/config-backup/config_restore.py"
MAXVOL := "150"
THEME := home_directory() / ".local/bin/theme-switch"

all: backup

backup:
	python {{BACKUP}}

# --- Restore -----------------------------------------------------------------
# The inverse of `just backup`: copies every tracked path out of ~/dotfiles and
# back to where it lives. The path list in backup_paths.json is the only record
# of where anything came from, so restore reads the same list backup writes.
#
#   just restore-check      show what would change, touch nothing  (start here)
#   just restore            copy it all back, after confirming
#   just restore-pushed     reset ~/dotfiles to origin/main first, then restore
#
# restore-check prints a numbered listing, and every recipe here takes those
# numbers, so you can copy back one piece and leave the rest alone:
#
#   just restore 1          entry [1] of the last listing, all of it
#   just restore 1 3        several entries
#   just restore 1-3        an inclusive range
#   just restore 1.2        just the file listed as 1.2
#   just restore hypr nvim  or select by substring instead of by number
#
# The numbers are positions in that listing, which only holds what is currently
# out of sync -- restore something and everything after it renumbers. They are
# meant to be read off a fresh restore-check and used immediately; the paths
# are always printed in full before the confirmation prompt, so check those,
# not the numbers.
#
# Everything about to be overwritten is archived to
# ~/.local/share/config-restore/pre-restore_<stamp>.tar.gz first, so a restore
# from the wrong commit is itself undoable (`tar -xzf <archive> -C ~`).
#
# Directories are MERGED, not mirrored: files that exist locally but were never
# backed up are left alone. That is deliberate -- the backup skips anything over
# 2 MB, which here means every compiled binary in ~/.local/bin (todo is 155 MB)
# and the larger wallpapers. `--clean` mirrors exactly and would delete all of
# them, so it is opt-in and worth a `restore-check --clean` first.
#
# After restoring ~/.config/hypr or ~/.config/quickshell, reload them:
# `hyprctl reload` and `just qs-reload` -- neither rereads config on its own.

# Copy every tracked config from ~/dotfiles back into place
[positional-arguments]
restore *ARGS:
	python {{RESTORE}} "$@"

# What `just restore` would change, without changing anything
[positional-arguments]
restore-check *ARGS:
	python {{RESTORE}} --dry-run "$@"

# Restore exactly what was last pushed (hard-resets ~/dotfiles to origin/main)
[positional-arguments]
restore-pushed *ARGS:
	python {{RESTORE}} --pull "$@"

# --- Quickshell desktop layer ------------------------------------------------
# The interactive shell: dock, Control Center, Settings, OSD, desktop widgets
# and the audio visualiser. Config in ~/.config/quickshell.
#
# It is started at login by ~/.config/hypr/autostart.lua and hot-reloads its own
# QML on edit, so day to day none of these are needed. They are for when a
# restart is genuinely required (a new file in qmldir), for checking it is alive,
# and for getting out of trouble.
#
# Nothing here can affect Hyprland. Killing the shell loses the panels and
# nothing else -- windows, workspaces, scratchpads and every keybind survive.

# Snapshot every config this migration can touch, into ~/.local/share/quickshell-backups
qs-backup:
	@~/.local/bin/quickshell-migration-backup

# Roll the whole desktop back to a snapshot:  just qs-restore <archive.tar.gz>
qs-restore ARCHIVE:
	@~/.local/bin/quickshell-migration-restore "{{ARCHIVE}}"

# Restart the shell and report whether it came back up
qs-reload:
	@~/.local/bin/qs-reload

# Alias for qs-reload. The old version pkill'd first, which qs-reload now does
# itself -- and did it with a pattern that could match the killing shell.

# Restart the shell (alias for qs-reload)
qs-restart: qs-reload

# Is the shell alive, and what does it think its state is?
qs-status:
	@quickshell ipc call shell status 2>/dev/null || echo "quickshell is not running"

# Useful when wiring a new bind in ~/.config/hypr/bindings.lua.

# List every IPC target the shell exposes to keybindings
qs-ipc:
	@quickshell ipc show 2>/dev/null || echo "quickshell is not running"

# THE way to debug a QML change: a config that fails to parse exits
# immediately and silently when daemonized, so run it where you can see why.

# Run the shell in the foreground with errors on stderr
qs-debug:
	@pkill -f 'forks/quickshell/build/src/[q]uickshell' 2>/dev/null || true
	@sleep 0.3
	quickshell -c default

# settings.json is rewritten from the defaults in
# ~/.config/quickshell/config/Settings.qml on the next start.
# Themes are NOT affected -- those live in theme-switch.

# The visualiser only draws when audio is playing AND a monitor is showing its
# wallpaper (it lives below every window). This sets up both so you can see it.

# Demo the audio visualiser for N seconds
qs-viz SECS="30":
	@~/.local/bin/qs-viz-demo {{SECS}}

# Reset every GUI setting to its defaults
qs-reset-settings:
	@rm -f ~/.config/quickshell/settings.json
	@~/.local/bin/qs-reload

# "$@" (via positional-arguments) passes each path as its own argument, so paths
# containing spaces survive; `{{PATHS}}` would join them and split on spaces.

# Track one or more paths in the nightly backup:  just add ~/.foo ~/.config/bar
[positional-arguments]
add +PATHS:
	python {{BACKUP}} add "$@"

drive SRC DEST=DEST:
	fpsync -n 8 \
		-o "-lptgoD -vhW --info=progress2 --exclude-from={{EXCLUDES}}" \
		"{{SRC}}" \
		"{{DEST}}"


loud VOL=MAXVOL:
    wpctl set-volume @DEFAULT_AUDIO_SINK@ {{VOL}}%

# --- Theming ----------------------------------------------------------------
# Retheme the entire desktop in one step: ghostty, bat, btop, waybar, wofi,
# wlogout, mako, tmux, GTK3, GTK4/libadwaita, the Hyprland border gradient and
# Quickshell -- plus the freedesktop portal, which carries the theme into
# Chromium, VS Code, Electron and every Flatpak.
#
#   just theme            list available themes and show the active one
#   just theme gruvbox    apply a theme everywhere
#   just theme auto       derive the palette from the current wallpaper
#   just theme-palette    preview what `auto` would derive, without applying
#   just theme-matugen    read or change how `auto` derives it
#
# Only the THEME:START/THEME:END blocks in each config are rewritten, so your
# layout, padding and comments survive every switch.
#
# `auto` hands the wallpaper to matugen (Google's Material Color Utilities),
# maps the Material You scheme it gets back onto the nine house colours, and
# then re-checks every one against WCAG -- Material's contrast model is tuned
# for phones, and 11px text in a status bar is not negotiable. It also rotates
# the accents apart when Material's fixed red `error` role collides with a red
# wallpaper, which would otherwise make "focused" and "critical" the same
# colour everywhere they are used.
#
# The hand-written themes are NOT re-derived: Catppuccin and Gruvbox are
# upstream palettes, and rebuilding them from a seed colour would replace them
# with something merely Catppuccin-flavoured. They still go through matugen's
# templates for GTK, so every theme reaches the toolkits.
#
# Changing the wallpaper while `auto` is active re-derives the palette
# automatically -- see ~/.config/hypr/scripts/apply-wallpaper.sh.

# Retheme the whole desktop (no arg lists themes)
theme NAME="--list":
    @{{THEME}} {{NAME}}

# Show which theme is currently applied
theme-current:
    @{{THEME}} --current

# Preview the palette `auto` would derive, with colour swatches
theme-palette IMAGE="":
    @{{THEME}} --palette {{IMAGE}}

# --- matugen -----------------------------------------------------------------
# The three knobs on `auto`'s derivation. Changing any of them re-applies the
# active theme in the same run, so the result is visible immediately.
#
#   just theme-matugen                    show the current options
#   just theme-matugen vibrant            pick an algorithm (9 of them)
#   just theme-matugen light              or a mode
#   just theme-matugen contrast 0.3       or a contrast offset, -1 to 1
#   just theme-matugen "muted dark"       any combination, any order
#
# The same options are in the Quickshell Settings GUI under Appearance -> Matugen.
# Both read and write the same file, so neither can disagree with the other.

# Read or change how `auto` derives its palette (no arg shows the options)
[positional-arguments]
theme-matugen *ARGS:
    @{{THEME}} --matugen "$@"

# matugen is a separate binary and is not packaged for Ubuntu 24.04. Without it
# `auto` silently falls back to the old hand-rolled derivation, which still
# works and is strictly worse.

# Install or update the matugen binary into ~/.local/bin
theme-install-matugen:
    #!/usr/bin/env bash
    set -euo pipefail
    url=$(curl -fsSL https://api.github.com/repos/InioX/matugen/releases/latest \
        | grep -o '"browser_download_url": "[^"]*x86_64[^"]*"' | cut -d'"' -f4 | head -1)
    [ -n "$url" ] || { echo "could not find a release asset" >&2; exit 1; }
    echo "downloading $url"
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    curl -fsSL "$url" | tar xz -C "$tmp"
    install -Dm755 "$tmp/matugen" ~/.local/bin/matugen
    ~/.local/bin/matugen --version
    echo "Now run:  just theme auto"

# --- Desktop portals ---------------------------------------------------------
# xdg-desktop-portal is how sandboxed and toolkit-agnostic applications ask this
# desktop for a file picker, a screen share, or the current colour scheme. Which
# backend answers which request is decided by
# ~/.config/xdg-desktop-portal/hyprland-portal.conf -- screen capture and global
# shortcuts go to xdg-desktop-portal-hyprland, everything else to -gtk.
#
# That routing is what makes `just theme` reach Chromium, VS Code and Flatpaks:
# they learn the desktop is dark through the GTK backend's Settings interface,
# not from any file theme-switch writes.

# Show which backend is answering, and whether both are running
portal-check:
    #!/usr/bin/env bash
    echo "XDG_CURRENT_DESKTOP = ${XDG_CURRENT_DESKTOP:-(unset)}"
    echo "config file         = ~/.config/xdg-desktop-portal/$(echo "${XDG_CURRENT_DESKTOP:-}" | tr 'A-Z' 'a-z')-portal.conf"
    echo
    echo "Running backends:"
    pgrep -a -f 'xdg-desktop-portal' | sed 's/^/  /' || echo "  none"
    echo
    echo "Colour scheme the portal is broadcasting:"
    gdbus call --session --dest org.freedesktop.portal.Desktop \
        --object-path /org/freedesktop/portal/desktop \
        --method org.freedesktop.portal.Settings.Read \
        org.freedesktop.appearance color-scheme 2>&1 | sed 's/^/  /'

# Restart every portal backend, after editing the routing config
portal-restart:
    systemctl --user restart xdg-desktop-portal-hyprland.service || true
    systemctl --user restart xdg-desktop-portal-gtk.service || true
    systemctl --user restart xdg-desktop-portal.service
    @echo "restarted -- run 'just portal-check' to confirm"

# --- The screen-share picker -------------------------------------------------
# The dialog that appears when something asks to capture the screen. It is the
# stock Qt6 picker from xdg-desktop-portal-hyprland -- deliberately, because it
# is the security boundary for screen capture and what it prints on stdout is
# what actually gets shared. Only its appearance is ours:
#
#   ~/.config/matugen/templates/share-picker.qss   the stylesheet, themed by
#                                                  `just theme` like everything else
#   ~/.local/bin/hyprland-share-picker-themed      adds Qt's -stylesheet argument
#   ~/.config/hypr/xdph.conf                       tells xdph to launch that wrapper
#   rules.lua "screen-share-picker"                floats it, sizes it, keeps it opaque
#
# Keyboard: Tab / Shift+Tab move, Left/Right switch tabs from the tab bar,
# Ctrl+Tab switches tabs from anywhere, Space or Enter picks the focused entry.
# The focused entry is the one with the thick accent border -- that ring is the
# whole reason the stylesheet exists.

# Open the share picker on its own, to see it without starting a screen share
picker-preview:
    #!/usr/bin/env bash
    # The real dialog gets its list of windows from xdph in this variable, as
    # repeated  handle[HC>]class[HC>]title[HC>]  triples. Synthesising it here
    # is what gives the Window tab something to look at.
    #
    # The handle is a DECIMAL uintptr. hyprctl reports it as hex ("0x5c1f..."),
    # and handing the picker the hex -- with or without the 0x -- aborts it with
    # a std::out_of_range out of substr, so the int(..., 16) is load-bearing.
    export XDPH_WINDOW_SHARING_LIST=$(hyprctl clients -j | python3 -c "
    import json, sys
    print(''.join(
        f\"{int(w['address'], 16)}[HC>]{w['class']}[HC>]{w['title']}[HC>]\"
        for w in json.load(sys.stdin) if w.get('mapped') and w.get('title')))")
    echo "Picked: $(~/.local/bin/hyprland-share-picker-themed)"

# Regenerate the picker stylesheet only, without retheming the whole desktop
picker-restyle:
    @{{THEME}} $({{THEME}} --current) 2>&1 | grep -E "matugen templates" || true
    @echo "stylesheet: ~/.config/hyprland-share-picker/style.qss"


clean-brave:
    pkill -x brave || true
    zsh -c 'setopt LOCAL_OPTIONS RM_STAR_SILENT; rm -rf ~/.cache/BraveSoftware/Brave-Browser/*'
clean-chrome:
    pkill -x chrome || true
    zsh -c 'setopt LOCAL_OPTIONS RM_STAR_SILENT; rm -rf ~/.cache/google-chrome/*'

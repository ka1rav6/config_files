{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-instruct-igpu": {
          "name": "Qwen2.5 7B Instruct (iGPU)"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  },
  "agent": {
    "build": {
      "maxTokens": 4096
    },
    "plan": {
      "maxTokens": 4096
    },
    "general": {
      "maxTokens": 4096
    },
    "explore": {
      "maxTokens": 2048
    }
  },
  "mcp": {
    "tinyfish": {
      "type": "remote",
      "url": "https://agent.tinyfish.ai/mcp?source=tinyfish_cli&client=opencode&connect_attempt_id=43b0bf4f-8060-40cf-84f1-76fa1a197975",
      "headers": {
        "X-API-Key": "{env:TINYFISH_API_KEY}"
      }
    }
  }
}

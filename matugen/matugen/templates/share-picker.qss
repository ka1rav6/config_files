/* THEME:START — generated by `theme-switch` via matugen. Do not edit. --------
 *
 * Stylesheet for hyprland-share-picker, the dialog that appears when an
 * application asks to capture the screen. Loaded by the wrapper at
 * ~/.local/bin/hyprland-share-picker-themed, which xdph launches instead of the
 * bare binary (see ~/.config/hypr/xdph.conf).
 *
 * WHY A STYLESHEET AND NOT A REPLACEMENT PICKER
 *   The picker is the security boundary for screen capture: what it prints on
 *   stdout is what gets shared, and its window list comes from the compositor
 *   through XDPH_WINDOW_SHARING_LIST. Reimplementing it would mean owning that
 *   correctness forever. It is a Qt6 Widgets app, so QApplication's built-in
 *   -stylesheet argument restyles every pixel of it without touching a line of
 *   its logic.
 *
 * WHAT THE WIDGETS ACTUALLY ARE
 *   QTabWidget            Screen / Window / Region
 *   QScrollArea           the list area under the tabs
 *   QPushButton           one per capturable screen or window -- these are
 *                         BUTTONS, not list items, which is why they are styled
 *                         as full-width cards rather than rows
 *   QCheckBox             "Allow a restore token" along the bottom
 *
 * THE FOCUS RING IS THE POINT
 *   Everything here is keyboard-reachable already -- Qt gives QPushButton and
 *   QCheckBox tab focus for free. What the default Fusion style does not do is
 *   make focus *visible* at a glance, so choosing a screen by keyboard means
 *   guessing where you are. Every :focus rule below is deliberately louder than
 *   its :hover rule: the mouse tells you where it is by being there, the
 *   keyboard has only this.
 */

/* --- the window ---------------------------------------------------------- */

QMainWindow, QWidget {
    background-color: {{house.bg}};
    color: {{house.text}};
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 14px;
}

/* --- tabs ---------------------------------------------------------------- */
/* Left/Right arrows move between these once the tab bar has focus, and
 * Ctrl+Tab cycles them from anywhere in the dialog. */

QTabWidget::pane {
    background-color: {{house.bg}};
    border: 1px solid {{house.border}};
    border-radius: 14px;
    top: -1px;
    padding: 6px;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: transparent;
    color: {{house.muted}};
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 9px 22px;
    margin-right: 4px;
    margin-bottom: 8px;
    font-weight: 500;
}

QTabBar::tab:hover:!selected {
    background-color: {{house.surface}};
    color: {{house.text}};
}

QTabBar::tab:selected {
    background-color: {{house.a1}};
    color: {{house.bg}};
    font-weight: 600;
}

/* The tab bar takes focus before the list does, so this ring is usually the
 * first thing a keyboard user sees. */
QTabBar::tab:focus {
    border: 2px solid {{house.a1}};
    color: {{house.text}};
}

QTabBar::tab:selected:focus {
    border: 2px solid {{house.text}};
    color: {{house.bg}};
}

/* --- the list area ------------------------------------------------------- */

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: {{house.border}};
    border-radius: 5px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: {{house.a1}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

/* --- one capturable source ----------------------------------------------- */
/* Left-aligned with generous padding: these read as rows of a list, and the
 * screen/window name is the thing being scanned, so it starts where the eye
 * already is rather than floating in the middle of a 1900px button. */

/* PADDING IS HORIZONTAL ONLY, AND THAT IS NOT A STYLE CHOICE
 * The picker gives these buttons a fixed height. Qt subtracts stylesheet
 * padding from that fixed height rather than growing the widget, so vertical
 * padding eats the text's own line box -- 16px top and bottom clipped the
 * label down to a 3px sliver of the middle of each glyph, which looks exactly
 * like a colour bug and is not one. min-height sets the row height instead;
 * the text stays vertically centred in whatever is left. */
QPushButton {
    background-color: {{house.surface}};
    color: {{house.text}};
    border: 1px solid {{house.border}};
    border-radius: 12px;
    padding-left: 20px;
    padding-right: 20px;
    min-height: 46px;
    margin: 3px 2px;
    text-align: left;
    font-size: 15px;
}

QPushButton:hover {
    background-color: {{house.surface2}};
    border-color: {{colors.primary_container.default.hex}};
}

/* Louder than :hover on purpose -- see the note at the top of this file.
 * A 2px accent border plus a tinted ground, so the focused row is obvious
 * even at a glance across a 1920px screen. */
QPushButton:focus {
    background-color: {{colors.primary_container.default.hex}};
    color: {{colors.on_primary_container.default.hex}};
    border: 2px solid {{house.a1}};
    /* One less pixel of horizontal padding, so the thicker border does not
     * shift the label sideways as focus moves down the list. */
    padding-left: 19px;
    padding-right: 19px;
}

QPushButton:pressed {
    background-color: {{house.a1}};
    color: {{house.bg}};
    border-color: {{house.a1}};
}

/* --- the restore-token checkbox ------------------------------------------ */
/* This one grants an application permission to skip this dialog entirely next
 * time, so it is styled as a deliberate choice rather than a footnote: a2 is
 * the palette's warning accent. */

QCheckBox {
    color: {{house.muted}};
    spacing: 10px;
    padding-left: 4px;
    padding-right: 4px;
    min-height: 28px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 13px;
}

QCheckBox:hover {
    color: {{house.text}};
}

QCheckBox:focus {
    border: 1px solid {{house.a2}};
    color: {{house.text}};
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: 5px;
    border: 2px solid {{house.border}};
    background-color: {{house.bg}};
}

QCheckBox::indicator:hover {
    border-color: {{house.a2}};
}

QCheckBox::indicator:checked {
    background-color: {{house.a2}};
    border-color: {{house.a2}};
}

QCheckBox::indicator:focus {
    border-color: {{house.a2}};
}

/* --- labels and tooltips ------------------------------------------------- */

QLabel {
    background: transparent;
    color: {{house.text}};
}

QToolTip {
    background-color: {{house.surface2}};
    color: {{house.text}};
    border: 1px solid {{house.border}};
    border-radius: 8px;
    padding: 8px 10px;
}

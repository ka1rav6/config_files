# --------------------------------------------------------------------------
# Colour helpers
# --------------------------------------------------------------------------
def _rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i : i + 2], 16) for i in (0, 2, 4))


def rgba(h, alpha):
    """#rrggbb -> 'rgba(r, g, b, a)' for GTK CSS."""
    r, g, b = _rgb(h)
    return f"rgba({r}, {g}, {b}, {alpha})"


def hexa(h, alpha_byte):
    """#rrggbb -> 'rrggbbAA' for hyprland/mako, alpha as a 0-255 byte."""
    return h.lstrip("#") + format(alpha_byte, "02x")


def mix(h1, h2, t):
    """Blend two hex colours; t=0 gives h1, t=1 gives h2."""
    a, b = _rgb(h1), _rgb(h2)
    return "#" + "".join(format(round(x + (y - x) * t), "02x") for x, y in zip(a, b))


# --------------------------------------------------------------------------
# Wallpaper-derived palettes  (`theme-switch auto`)
# --------------------------------------------------------------------------
# Derives the same nine colours every other theme defines, from the current
# wallpaper, and then feeds them through the exact same apply() path. That is
# the whole design: this is a PALETTE GENERATOR, not a second theme system.
# Nothing downstream -- waybar, mako, Hyprland, Quickshell, ghostty -- can tell
# whether the nine colours it received were hand-picked or extracted.
#
# HOW THE ACCENTS ARE CHOSEN
#   1. Downscale to 160px. Colour proportion survives; the cost does not.
#   2. Weight every pixel by saturation^1.5 * value. A photograph is mostly
#      desaturated mid-tones, and an unweighted average of one is always mud.
#      The exponent biases hard towards the few genuinely colourful pixels,
#      which is what the eye actually reads as "the colour of that image".
#   3. Histogram the weights into 36 hue buckets and smooth circularly, so a
#      hue sitting on a bucket boundary is not split in half and beaten by a
#      weaker one that happens to be centred.
#   4. Take the strongest bucket, then the strongest at least 50 degrees away,
#      then the strongest 50 degrees from both. The separation is what stops
#      three near-identical blues being returned as "three accents".
#
# WHY THE ACCENTS ARE THEN NORMALISED
#   The extracted hue is kept; the saturation and value are NOT. Every built-in
#   theme here uses light, slightly-desaturated accents on a near-black ground,
#   because that is what stays legible in a status bar at 11px. An accent taken
#   raw from an image is as likely to be a dark navy as a pastel mint, so the
#   hue is transplanted onto the house S/V and only the hue varies.
#
# WHY CONTRAST IS THEN ENFORCED
#   Even normalised, some hues (pure blue, deep violet) are intrinsically dark
#   and land under 4.5:1 against the background. Rather than accept an accent
#   that cannot be read, each is lightened a step at a time until it passes.
#   Text is held to 7:1 (WCAG AAA) and accents to 4.5:1 (AA). A generated theme
#   is therefore never less readable than a hand-written one -- which is the
#   part most wallpaper-theming tools get wrong.
#
# THE GREYSCALE CASE
#   A black-and-white wallpaper has no hue to extract, and the strongest bucket
#   is then pure sensor noise -- which is how these tools end up inventing a
#   teal accent for a monochrome image. `_chromatic_confidence` measures what
#   fraction of the lit pixels carry real colour; below the threshold the image
#   is declared achromatic and the accents of the base theme are kept, with
#   only the neutrals tinted. Honest, and it looks deliberate rather than
#   random.
# --------------------------------------------------------------------------

# Fraction of lit pixels that must be meaningfully saturated before the hue
# histogram is trusted. Measured: a blue/purple space wallpaper scores 0.97, a
# pure black-and-white one scores 0.00, flat grey scores 0.00.
CHROMA_CONFIDENCE_MIN = 0.12

# The house style for an accent, as (saturation, value). Taken from the spread
# of the nine built-in themes -- all of them sit near these.
ACCENT_SV = ((0.42, 0.86), (0.50, 0.82), (0.55, 0.80))

# Neutrals, as (saturation, value). The tiny saturation is what makes a
# generated theme feel like it belongs to its wallpaper rather than being grey
# furniture placed in front of it -- the greys carry a whisper of the dominant
# hue.
NEUTRAL_SV = {
    "bg": (0.10, 0.085),
    "surface": (0.13, 0.145),
    "surface2": (0.15, 0.205),
    "border": (0.12, 0.330),
    "text": (0.04, 0.970),
    "muted": (0.07, 0.800),
}

# WCAG contrast floors, against the generated background.
CONTRAST_TEXT = 7.0    # AAA for body text
CONTRAST_MUTED = 4.5   # AA  for secondary text
CONTRAST_ACCENT = 4.5  # AA  -- accents are used for text and icons, not just fills


def _linearise(c):
    """sRGB channel (0..1) -> linear light, per the sRGB transfer function."""
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def luminance(rgb):
    """WCAG relative luminance of an (r, g, b) tuple in 0..1."""
    r, g, b = (_linearise(x) for x in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast_ratio(rgb1, rgb2):
    """WCAG contrast ratio. 1.0 is identical, 21.0 is black on white."""
    l1, l2 = luminance(rgb1), luminance(rgb2)
    if l1 < l2:
        l1, l2 = l2, l1
    return (l1 + 0.05) / (l2 + 0.05)


def _to_hex(rgb):
    return "#" + "".join(format(max(0, min(255, round(c * 255))), "02x") for c in rgb)


def _from_hex(h):
    h = h.lstrip("#")
    return tuple(int(h[i : i + 2], 16) / 255.0 for i in (0, 2, 4))


def _hsv(h, s, v):
    return colorsys.hsv_to_rgb(h % 1.0, max(0.0, min(1.0, s)), max(0.0, min(1.0, v)))


def _lift_until(rgb_hsv, background, target):
    """Raise a colour's value until it clears `target` contrast on `background`.

    Returns the adjusted rgb. Gives up at v=1.0 rather than looping forever --
    a hue that cannot reach the target even at full brightness is returned as
    bright as it goes, which is the best available answer.
    """
    h, sat, val = rgb_hsv
    rgb = _hsv(h, sat, val)
    while contrast_ratio(rgb, background) < target and val < 1.0:
        val = min(1.0, val + 0.01)
        rgb = _hsv(h, sat, val)
    return rgb


def _hue_histogram(image_path, bins=36):
    """Weighted circular hue histogram, plus how chromatic the image is.

    Returns (histogram, chromatic_confidence). Imports are local so that the
    ordinary `theme-switch <name>` path never pays for loading numpy and
    Pillow -- they are only needed by `auto`.
    """
    import numpy as np
    from PIL import Image

    image = Image.open(image_path).convert("RGB")
    # Colour proportions survive a downscale; reading 5 megapixels does not
    # improve the answer and takes a noticeable fraction of a second.
    image.thumbnail((160, 160))
    a = np.asarray(image, dtype=np.float32) / 255.0

    mx = a.max(axis=2)
    mn = a.min(axis=2)
    value = mx
    sat = np.where(mx > 0, (mx - mn) / np.maximum(mx, 1e-6), 0.0)

    # Hue, by the standard max-channel formulation. `delta` is floored to avoid
    # a divide-by-zero on grey pixels; those are masked out by `mn == mx` after.
    r, g, b = a[..., 0], a[..., 1], a[..., 2]
    delta = np.maximum(mx - mn, 1e-6)
    hue = np.select(
        [mx == r, mx == g],
        [((g - b) / delta) % 6, ((b - r) / delta) + 2],
        ((r - g) / delta) + 4,
    ) / 6.0
    hue = np.where(mn == mx, 0.0, hue)

    # "Lit" excludes near-black, where hue is meaningless and noisy.
    lit = value > 0.15
    chromatic = (sat > 0.18) & lit
    confidence = float(chromatic.sum() / max(int(lit.sum()), 1))

    weight = (sat ** 1.5) * value * (value > 0.12) * (sat > 0.10)
    index = np.clip((hue * bins).astype(int), 0, bins - 1)
    hist = np.bincount(index.ravel(), weights=weight.ravel(), minlength=bins)

    # Circular 5-tap smooth. Wrapping the ends is what makes it circular --
    # red at 355 degrees and red at 5 degrees are the same colour and must
    # reinforce each other rather than landing in opposite ends of the array.
    kernel = np.array([1.0, 3.0, 5.0, 3.0, 1.0])
    padded = np.concatenate([hist[-2:], hist, hist[:2]])
    hist = np.array([float((padded[i : i + 5] * kernel).sum()) for i in range(bins)])

    return hist, confidence


def _pick_hues(hist, bins=36, min_separation=5):
    """The three strongest well-separated hues, as 0..1 floats.

    min_separation is in buckets, so 5 buckets is 50 degrees. Without it the
    top three are routinely three adjacent buckets of the same colour.
    """
    picked = []
    for i in sorted(range(bins), key=lambda j: hist[j], reverse=True):
        if hist[i] <= 0:
            break
        if all(min(abs(i - j), bins - abs(i - j)) >= min_separation for j in picked):
            picked.append(i)
        if len(picked) == 3:
            break
    # Bucket centre, not its edge.
    return [(i + 0.5) / bins for i in picked]



# --------------------------------------------------------------------------
# matugen — the colour engine
# --------------------------------------------------------------------------
# What used to be ~200 lines of hue histograms, HSV transplants and hand-tuned
# constants in this file is now one subprocess call. matugen implements Google's
# Material Color Utilities: it quantises the image in CAM16, picks a seed, and
# builds a full tonal system around it. It is better at this than the code it
# replaced -- it understands perceptual lightness rather than HSV value, so a
# saturated orange and a saturated blue at the same "brightness" actually look
# the same brightness.
#
# WHAT IS *NOT* DELEGATED
#   The WCAG floors below still run afterwards. Material's contrast model is
#   its own, tuned for phone screens at arm's length; this desktop has 11px
#   text in a status bar and the AAA/AA guarantees in CONTRAST_* are not
#   negotiable. matugen proposes, contrast_ratio() disposes.
#
#   The nine-colour house schema also stays. Every consumer in apply() speaks
#   bg/surface/surface2/border/text/muted/a1/a2/a3, so matugen's fifty Material
#   roles are mapped down to those nine at the boundary and nothing downstream
#   learned a new vocabulary.
#
# IF matugen IS NOT INSTALLED
#   The old derivation is still here as palette_from_wallpaper_legacy() and is
#   used automatically. `auto` never stops working; it just gets worse. Install
#   with `just theme-install-matugen`.
# --------------------------------------------------------------------------

MATUGEN = shutil.which("matugen") or str(HOME / ".local/bin/matugen")

# How matugen should build the scheme. Persisted so the CLI and the Quickshell
# Settings UI agree, and so `auto` re-derives identically when the wallpaper
# changes without anyone having to pass flags again.
MATUGEN_STATE = CFG / "matugen-options.json"

MATUGEN_CONFIG = CFG / "matugen/config.toml"

# The scheme algorithms matugen offers, with what each is actually for. Shown
# verbatim in the Settings UI, so the descriptions are user-facing copy.
MATUGEN_SCHEMES = {
    "scheme-tonal-spot": "Balanced. The Material You default — one hue, muted.",
    "scheme-content": "Closest to the wallpaper. Keeps its real colours.",
    "scheme-vibrant": "Saturated. Strongest accents, most contrast between them.",
    "scheme-expressive": "Playful. Pushes the secondary and tertiary hues apart.",
    "scheme-fidelity": "Faithful. Like content, but preserves chroma exactly.",
    "scheme-neutral": "Nearly grey. The wallpaper barely tints anything.",
    "scheme-monochrome": "No colour at all. Greyscale, seeded by the image.",
    "scheme-fruit-salad": "Loose. Shifts the hue before building the scheme.",
    "scheme-rainbow": "Wide. Accents spread right around the wheel.",
}

# An image usually offers several defensible seed colours. This picks between
# them without prompting -- matugen otherwise refuses to choose and errors out
# when it cannot find a terminal to ask at, which is every call made from here.
# "saturation" takes the most colourful candidate, which is what you want for
# an accent: the alternatives all tend towards picking the wallpaper's
# background instead of the thing in front of it.
MATUGEN_PREFER = {
    "saturation": "Most colourful candidate. Liveliest accents.",
    "less-saturation": "Most muted candidate. Calmest accents.",
    "lightness": "Brightest candidate.",
    "darkness": "Darkest candidate. Usually the wallpaper's background.",
    "value": "Highest raw value, ignoring saturation.",
}

MATUGEN_DEFAULTS = {
    "scheme": "scheme-tonal-spot",
    "mode": "dark",
    "contrast": 0.0,
    "prefer": "saturation",
}


def matugen_available():
    return Path(MATUGEN).exists()


def matugen_options():
    """The persisted scheme/mode/contrast, with defaults filled in."""
    opts = dict(MATUGEN_DEFAULTS)
    if MATUGEN_STATE.exists():
        try:
            opts.update(json.loads(MATUGEN_STATE.read_text()))
        except (ValueError, OSError):
            pass
    if opts.get("scheme") not in MATUGEN_SCHEMES:
        opts["scheme"] = MATUGEN_DEFAULTS["scheme"]
    if opts.get("mode") not in ("dark", "light"):
        opts["mode"] = MATUGEN_DEFAULTS["mode"]
    if opts.get("prefer") not in MATUGEN_PREFER:
        opts["prefer"] = MATUGEN_DEFAULTS["prefer"]
    try:
        opts["contrast"] = max(-1.0, min(1.0, float(opts.get("contrast", 0.0))))
    except (TypeError, ValueError):
        opts["contrast"] = 0.0
    return opts


def save_matugen_options(**changes):
    """Merge changes into the persisted options and return the result."""
    opts = matugen_options()
    opts.update({k: v for k, v in changes.items() if v is not None})
    MATUGEN_STATE.write_text(json.dumps(opts, indent=2) + "\n")
    return matugen_options()


def _matugen_run(args, import_json=None, templates=False):
    """Invoke matugen. Returns (colors_dict_or_None, error_string_or_None).

    `templates=False` passes --dry-run, because the common case -- deriving a
    palette -- must not write GTK files: apply() has not decided yet whether
    this theme is even going to be applied, and check() can still refuse it.
    """
    opts = matugen_options()
    cmd = [MATUGEN, "-q", "-c", str(MATUGEN_CONFIG),
           "-t", opts["scheme"], "-m", opts["mode"],
           "--contrast", str(opts["contrast"]),
           "--prefer", opts["prefer"], "-j", "hex"]
    if not templates:
        cmd.append("--dry-run")
    if import_json:
        cmd += ["--import-json-string", json.dumps(import_json)]
    cmd += args
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as exc:
        return None, str(exc)
    if proc.returncode != 0:
        return None, (proc.stderr or proc.stdout or "").strip().splitlines()[-1:] and \
            (proc.stderr or proc.stdout).strip().splitlines()[-1] or "matugen failed"
    try:
        return json.loads(proc.stdout)["colors"], None
    except (ValueError, KeyError) as exc:
        return None, f"unreadable matugen output: {exc}"


# Material You role  ->  house role. The load-bearing translation in this file.
#
# Material names a surface by its elevation and a foreground by what it sits
# on; the house schema names them by what they are for. These nine pairings are
# the ones where those two vocabularies mean the same thing:
#
#   surface / container / container_high   the three greys, dark to light
#   outline_variant                        borders -- outline proper is far too
#                                          bright for a 1px line at this size
#   on_surface / on_surface_variant        body text and secondary text
#   primary / tertiary / error             a1 / a2 / a3, i.e. good / warn / bad
#
# secondary is deliberately unused: Material's secondary is a desaturated
# sibling of primary, which as a2 would read as "the same accent, but broken".
# tertiary is the one Material intends to contrast against primary.
MD3_TO_HOUSE = {
    "bg": "surface",
    "surface": "surface_container",
    "surface2": "surface_container_high",
    "border": "outline_variant",
    "text": "on_surface",
    "muted": "on_surface_variant",
    "a1": "primary",
    "a2": "tertiary",
    "a3": "error",
}



# Minimum hue separation between two accents, as a fraction of the wheel.
# 0.055 is ~20 degrees: below that two swatches at 11px are the same colour.
ACCENT_HUE_MIN = 0.055


def _separate_accents(palette, notes):
    """Push a1/a2/a3 apart until each is visibly its own colour.

    Only hue moves. Saturation and value are Material's and are what make the
    three look like a set; rotating hue keeps that while restoring the one
    thing the palette is actually used for -- telling good from warning from
    critical at a glance.
    """
    hsv = {k: list(colorsys.rgb_to_hsv(*_from_hex(palette[k]))) for k in ("a1", "a2", "a3")}

    def gap(a, b):
        d = abs(hsv[a][0] - hsv[b][0])
        return min(d, 1.0 - d)

    # a1 is the identity of the theme and never moves. a2 is nudged off a1,
    # then a3 off both -- in that order, so a fix to one cannot recreate the
    # collision it was fixing.
    for key, others, direction in (("a2", ("a1",), 1), ("a3", ("a1", "a2"), -1)):
        for _ in range(24):
            if all(gap(key, o) >= ACCENT_HUE_MIN for o in others):
                break
            hsv[key][0] = (hsv[key][0] + direction * 0.02) % 1.0
        else:
            continue
    for key in ("a2", "a3"):
        moved = _to_hex(_hsv(*hsv[key]))
        if moved != palette[key]:
            notes.append(f"rotated {key} off a1 for separation: {palette[key]} -> {moved}")
            palette[key] = moved
    return palette


def palette_from_matugen(source, is_image=True, base_theme="mint"):
    """Derive the nine house colours from an image or a seed colour.

    Returns (palette, notes) exactly like the legacy derivation, or raises
    RuntimeError if matugen could not produce a scheme -- the caller falls back.
    """
    opts = matugen_options()
    args = ["image", str(source)] if is_image else ["color", "hex", str(source)]
    colors, err = _matugen_run(args)
    if colors is None:
        raise RuntimeError(err or "matugen produced nothing")

    notes = [
        f"matugen {opts['scheme'].removeprefix('scheme-')}, {opts['mode']} mode, "
        f"seed by {opts['prefer']}"
        + (f", contrast {opts['contrast']:+.1f}" if opts["contrast"] else "")
    ]

    # matugen nests each role as {"default": {"color": "#rrggbb"}, ...}. The
    # "default" branch is already the one for the mode that was requested, so
    # there is no second mode decision to make here.
    palette = {
        house: colors[md3]["default"]["color"]
        for house, md3 in MD3_TO_HOUSE.items()
    }

    # --- keep the three accents telling apart -----------------------------
    # Material's `error` is a FIXED red -- it is a semantic role, not a derived
    # one, so a red wallpaper produces a1 and a3 within a few degrees of each
    # other and "focused" becomes indistinguishable from "critical" everywhere
    # they are used: workspace pills, notification urgency, the border gradient.
    # Rotate whichever one collided, keeping its lightness and chroma so the
    # scheme still reads as one system.
    palette = _separate_accents(palette, notes)

    # --- the WCAG floors this desktop does not negotiate ------------------
    # Material's own contrast model targets phone-sized text. Lift anything
    # that misses the floor, keeping hue and saturation so the scheme still
    # reads as one system, and report what moved rather than doing it silently.
    bg_rgb = _from_hex(palette["bg"])
    for key, target in (("text", CONTRAST_TEXT), ("muted", CONTRAST_MUTED),
                        ("a1", CONTRAST_ACCENT), ("a2", CONTRAST_ACCENT),
                        ("a3", CONTRAST_ACCENT)):
        rgb = _from_hex(palette[key])
        before = contrast_ratio(rgb, bg_rgb)
        if before >= target:
            continue
        h_, s_, v_ = colorsys.rgb_to_hsv(*rgb)
        lifted = _lift_until((h_, s_, v_), bg_rgb, target)
        palette[key] = _to_hex(lifted)
        notes.append(
            f"lifted {key} for WCAG: {before:.1f}:1 -> "
            f"{contrast_ratio(lifted, bg_rgb):.1f}:1 (floor {target})"
        )

    # ghostty, bat and btop take a theme NAME, not colours, so the closest
    # built-in still has to be chosen by hue -- matugen has nothing to say here.
    nearest = _nearest_builtin(palette["a1"])
    palette["ghostty"] = THEMES[nearest]["ghostty"]
    palette["bat"] = THEMES[nearest]["bat"]
    palette["btop"] = THEMES[nearest]["btop"]
    palette["desc"] = (
        f"matugen {opts['scheme'].removeprefix('scheme-')} from "
        f"{Path(source).name if is_image else source}"
    )
    notes.append(f"terminal/btop follow the nearest built-in theme: {nearest}")

    for name, floor in (("text", CONTRAST_TEXT), ("a1", CONTRAST_ACCENT),
                        ("a2", CONTRAST_ACCENT), ("a3", CONTRAST_ACCENT)):
        ratio = contrast_ratio(_from_hex(palette[name]), bg_rgb)
        flag = "" if ratio >= floor else f"  BELOW {floor}:1"
        notes.append(f"contrast {name}/bg = {ratio:.1f}:1{flag}")

    return palette, notes


def run_matugen_templates(name, t):
    """Push the applied palette through the matugen templates.

    This is the half of matugen that runs for EVERY theme, not just `auto`: it
    is how GTK3, GTK4/libadwaita and the portal colour scheme get themed at
    all. See ~/.config/matugen/config.toml for why the templates read the house
    palette rather than matugen's own derivation.

    Returns a one-line status for apply()'s report. Never raises: GTK theming
    is the least important thing this script does and must not be able to fail
    a theme switch.
    """
    if not matugen_available():
        return "SKIPPED matugen templates (matugen not installed)"
    if not MATUGEN_CONFIG.exists():
        return f"SKIPPED matugen templates ({MATUGEN_CONFIG} missing)"

    house = {k: t[k] for k in MD3_TO_HOUSE}
    house["name"] = name
    # Seeded from the palette's own primary accent, so matugen's container and
    # fixed tones -- the ones the house schema has no name for -- land in the
    # same hue family as the theme they are filling in around.
    _, err = _matugen_run(["color", "hex", t["a1"]],
                          import_json={"house": house}, templates=True)
    if err:
        return f"SKIPPED matugen templates ({err})"
    # Named from the config rather than hardcoded, so adding a template there
    # does not leave this line quietly lying about what was written.
    try:
        names = re.findall(r"^\s*\[templates\.([^\]]+)\]", MATUGEN_CONFIG.read_text(), re.M)
    except OSError:
        names = []
    return "wrote matugen templates: " + (", ".join(names) if names else "(none)")


def gtk_colour_scheme(t):
    """Tell GTK and the portal whether this theme is dark or light.

    The freedesktop Settings portal reads org.gnome.desktop.interface, so this
    one gsettings write is what carries the theme into Chromium, VS Code,
    Electron and every Flatpak -- none of which can read a single file this
    script otherwise touches. Measured from the background's own luminance
    rather than from the matugen mode option, because a hand-written theme
    never went through matugen.
    """
    dark = luminance(_from_hex(t["bg"])) < 0.25
    scheme = "prefer-dark" if dark else "prefer-light"
    try:
        subprocess.run(
            ["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme],
            capture_output=True, timeout=5, check=True,
        )
    except (OSError, subprocess.SubprocessError):
        return "SKIPPED gsettings colour scheme (gsettings unavailable)"
    # Accent colour, for the GNOME 47+ apps that honour it. Nearest of the
    # eleven names GNOME accepts -- it is an enum, not a hex field.
    try:
        subprocess.run(
            ["gsettings", "set", "org.gnome.desktop.interface", "accent-color",
             _gnome_accent(t["a1"])],
            capture_output=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        pass
    return f"gsettings color-scheme = {scheme}"


# GNOME's accent-color is a fixed enum, so the palette's accent has to be
# rounded to whichever of these it is closest to in hue.
_GNOME_ACCENTS = {
    "blue": "#3584e4", "teal": "#2190a4", "green": "#3a944a",
    "yellow": "#c88800", "orange": "#ed5b00", "red": "#e62d42",
    "pink": "#d56199", "purple": "#9141ac", "slate": "#6f8396",
}


def _gnome_accent(hex_colour):
    want = colorsys.rgb_to_hsv(*_from_hex(hex_colour))
    if want[1] < 0.15:
        return "slate"
    best, best_d = "blue", 2.0
    for name, hx in _GNOME_ACCENTS.items():
        have = colorsys.rgb_to_hsv(*_from_hex(hx))
        d = abs(want[0] - have[0])
        d = min(d, 1.0 - d)
        if d < best_d:
            best, best_d = name, d
    return best


def palette_from_wallpaper(image_path, base_theme="mint"):
    """Derive the nine house colours from an image.

    matugen does the deriving. The hand-rolled hue-histogram version below is
    kept only as the fallback for a machine without matugen installed -- it is
    what this function used to be, and it is strictly worse.
    """
    if matugen_available():
        try:
            return palette_from_matugen(image_path, is_image=True,
                                        base_theme=base_theme)
        except RuntimeError as exc:
            print(f"  matugen failed ({exc}) -- falling back to the built-in "
                  f"derivation", file=sys.stderr)
    else:
        print("  matugen is not installed -- using the built-in derivation. "
              "Install it with `just theme-install-matugen`.", file=sys.stderr)
    return palette_from_wallpaper_legacy(image_path, base_theme=base_theme)


def palette_from_wallpaper_legacy(image_path, base_theme="mint"):
    """Derive a full nine-colour palette from an image.

    Returns (palette_dict, notes). `notes` is a list of human-readable lines
    explaining what was derived and why, printed by main() so the result is
    never a black box.
    """
    base = THEMES[base_theme]
    notes = []

    hist, confidence = _hue_histogram(image_path)
    achromatic = confidence < CHROMA_CONFIDENCE_MIN

    if achromatic:
        # No trustworthy hue in the image. Keep the base theme's accents and
        # tint the neutrals towards its primary, so the desktop still reads as
        # a deliberate monochrome rather than as three random colours.
        notes.append(
            f"image is effectively greyscale (chroma {confidence:.0%} < "
            f"{CHROMA_CONFIDENCE_MIN:.0%}) -- keeping {base_theme}'s accents"
        )
        accent_hex = [base["a1"], base["a2"], base["a3"]]
        neutral_hue = colorsys.rgb_to_hsv(*_from_hex(base["a1"]))[0]
    else:
        hues = _pick_hues(hist)
        if not hues:
            hues = [colorsys.rgb_to_hsv(*_from_hex(base["a1"]))[0]]
        # Fewer than three separated hues in the image: complete the set
        # harmonically rather than repeating one. +40 degrees is an analogous
        # partner, -150 is a split-complement -- both reliably distinct from
        # the first without clashing with it.
        while len(hues) < 3:
            hues.append((hues[0] + (0.11 if len(hues) == 1 else -0.42)) % 1.0)

        notes.append(
            "dominant hues: "
            + ", ".join(f"{round(h * 360)}deg" for h in hues)
            + f" (chroma {confidence:.0%})"
        )
        accent_hex = None
        neutral_hue = hues[0]

    # --- neutrals ---------------------------------------------------------
    neutral = {k: _hsv(neutral_hue, s, v) for k, (s, v) in NEUTRAL_SV.items()}

    # Text has to clear AAA against the generated background, and `muted` AA.
    # Both are lightened rather than the background being darkened, because the
    # background tone is what carries the wallpaper's character.
    for key, target in (("text", CONTRAST_TEXT), ("muted", CONTRAST_MUTED)):
        s_, v_ = NEUTRAL_SV[key]
        neutral[key] = _lift_until((neutral_hue, s_, v_), neutral["bg"], target)

    # --- accents ----------------------------------------------------------
    if accent_hex is None:
        accents = []
        for hue, (s_, v_) in zip(hues, ACCENT_SV):
            accents.append(_lift_until((hue, s_, v_), neutral["bg"], CONTRAST_ACCENT))
        accent_hex = [_to_hex(c) for c in accents]
    else:
        # Base-theme accents still have to be readable on the *generated*
        # background, which is not the one they were designed against.
        lifted = []
        for hx in accent_hex:
            h_, s_, v_ = colorsys.rgb_to_hsv(*_from_hex(hx))
            lifted.append(_to_hex(_lift_until((h_, s_, v_), neutral["bg"], CONTRAST_ACCENT)))
        accent_hex = lifted

    palette = {k: _to_hex(v) for k, v in neutral.items()}
    palette["a1"], palette["a2"], palette["a3"] = accent_hex

    # --- the apps that need a NAMED theme, not colours --------------------
    # ghostty, bat and btop are configured by theme name, so `auto` has to pick
    # the closest built-in rather than hand them hex. Nearest is measured by
    # hue distance from the generated primary accent to each theme's, which
    # keeps the terminal in the same colour family as the desktop.
    nearest = _nearest_builtin(palette["a1"])
    palette["ghostty"] = THEMES[nearest]["ghostty"]
    palette["bat"] = THEMES[nearest]["bat"]
    palette["btop"] = THEMES[nearest]["btop"]
    palette["desc"] = f"derived from {Path(image_path).name}"
    notes.append(f"terminal/btop follow the nearest built-in theme: {nearest}")

    for name, floor in (("text", CONTRAST_TEXT), ("a1", CONTRAST_ACCENT),
                        ("a2", CONTRAST_ACCENT), ("a3", CONTRAST_ACCENT)):
        ratio = contrast_ratio(_from_hex(palette[name]), _from_hex(palette["bg"]))
        flag = "" if ratio >= floor else f"  BELOW {floor}:1 -- hue too dark to lift"
        notes.append(f"contrast {name}/bg = {ratio:.1f}:1{flag}")

    return palette, notes


def write_catalogue():
    """Emit every theme's palette for the Settings GUI to draw swatches from.

    ~/.config/quickshell/themes.json. Written on every apply, so the GUI's list
    can never drift from THEMES above -- adding a theme here makes it appear in
    Settings with no second edit anywhere.

    `auto` is included with the palette it most recently derived, so its swatch
    shows the wallpaper's actual colours rather than a placeholder.
    """
    catalogue = []
    for name, theme in THEMES.items():
        catalogue.append({
            "id": name,
            "label": name.capitalize(),
            "desc": theme["desc"],
            "bg": theme["bg"],
            "surface": theme["surface"],
            "text": theme["text"],
            "a1": theme["a1"],
            "a2": theme["a2"],
            "a3": theme["a3"],
        })

    # `auto` last, so it reads as "and also, derived from your wallpaper".
    auto = {
        "id": "auto",
        "label": "Wallpaper",
        "desc": "derived from the current wallpaper",
        "bg": "#141416", "surface": "#202125", "text": "#edf0f7",
        "a1": "#7f96db", "a2": "#a669d1", "a3": "#5cccc3",
    }
    if AUTO_STATE.exists():
        try:
            stored = json.loads(AUTO_STATE.read_text()).get("palette")
            if stored:
                auto.update({k: stored[k] for k in
                             ("bg", "surface", "text", "a1", "a2", "a3") if k in stored})
                auto["desc"] = stored.get("desc", auto["desc"])
        except (ValueError, OSError, KeyError):
            pass
    catalogue.append(auto)

    try:
        QS_THEME.parent.mkdir(parents=True, exist_ok=True)
        # A top-level OBJECT, not a bare array: Quickshell's JsonAdapter
        # deserialises into named properties and refuses an array at the root
        # ("Failed to deserialize json: not an object").
        (QS_THEME.parent / "themes.json").write_text(
            json.dumps({"themes": catalogue}, indent=2) + "\n"
        )
        return f"themed: {QS_THEME.parent / 'themes.json'}"
    except OSError as e:
        return f"SKIPPED (catalogue): {e}"


def _nearest_builtin(accent_hex):
    """The built-in theme whose primary accent is closest in hue."""
    target = colorsys.rgb_to_hsv(*_from_hex(accent_hex))[0]
    best, best_distance = "mint", 2.0
    for name, theme in THEMES.items():
        hue = colorsys.rgb_to_hsv(*_from_hex(theme["a1"]))[0]
        # Circular distance -- hue is an angle, so 0.95 and 0.05 are close.
        distance = min(abs(hue - target), 1.0 - abs(hue - target))
        if distance < best_distance:
            best, best_distance = name, distance
    return best


def current_wallpaper():
    """The path in ~/.config/hypr/wallpaper.conf, or None.

    That file is the single source of truth for the wallpaper -- hyprpaper and
    hyprlock both source it. Parsed rather than imported because it is Hyprland
    config syntax: `$wallpaper = /absolute/path`.
    """
    if not WALLPAPER_CONF.exists():
        return None
    match = re.search(
        r"^\s*\$wallpaper\s*=\s*(.+?)\s*$", WALLPAPER_CONF.read_text(), re.M
    )
    if not match:
        return None
    path = Path(os.path.expanduser(match.group(1)))
    return path if path.exists() else None


def resolve_theme(name):
    """Return the nine-colour palette for a theme name.

    Every consumer goes through here rather than indexing THEMES directly, so
    that `auto` -- which has no static entry -- behaves identically to a
    hand-written theme everywhere downstream.
    """
    if name != "auto":
        return THEMES[name], []

    wallpaper = current_wallpaper()
    if wallpaper is None:
        raise SystemExit(
            f"auto needs a wallpaper, and {WALLPAPER_CONF} does not point at a "
            f"readable image.\nSet one first:  "
            f"~/.config/hypr/scripts/apply-wallpaper.sh /path/to/image"
        )

    # The base theme supplies the accents when the image has no usable hue, and
    # is whatever named theme was last applied. Recorded separately from STATE
    # so that applying `auto` twice does not make `auto` its own base.
    base = "mint"
    if AUTO_STATE.exists():
        try:
            base = json.loads(AUTO_STATE.read_text()).get("base", base)
        except (ValueError, OSError):
            pass
    elif STATE.exists():
        candidate = STATE.read_text().strip()
        if candidate in THEMES:
            base = candidate

    palette, notes = palette_from_wallpaper(wallpaper, base_theme=base)
    AUTO_STATE.write_text(
        json.dumps(
            {"source": str(wallpaper), "base": base, "palette": palette}, indent=2
        )
        + "\n"
    )
    return palette, notes


# --------------------------------------------------------------------------
# File patching
# --------------------------------------------------------------------------
def patch_block(path, body, start="THEME:START", end="THEME:END"):
    """Replace everything between the two markers. Leaves the markers in place."""
    p = Path(path)
    if not p.exists():
        return f"skipped (missing): {p}"
    s = p.read_text()
    # The start marker must also carry "generated by". Without that extra
    # anchor, an ordinary sentence in a header comment that happens to mention
    # the marker name would be treated as the start of the block, and
    # everything from there to the real marker would be eaten. That is not
    # hypothetical -- it happened to wofi/style.css while this was written.
    pat = re.compile(
        r"(?P<start>^[^\n]*" + re.escape(start) + r"[^\n]*generated by[^\n]*\n)"
        r".*?"
        r"(?P<end>^[^\n]*" + re.escape(end) + r"[^\n]*$)",
        re.S | re.M,
    )
    if not pat.search(s):
        return f"SKIPPED (no {start} marker): {p}"
    s2 = pat.sub(lambda m: m.group("start") + body + m.group("end"), s, count=1)
    p.write_text(s2)
    return f"themed: {p}"


def patch_key(path, key, value, sep=" = ", quote=False):
    """Replace a single `key = value` line, matched by key name."""
    p = Path(path)
    if not p.exists():
        return f"skipped (missing): {p}"
    s = p.read_text()
    v = f'"{value}"' if quote else value
    pat = re.compile(r"^(\s*)" + re.escape(key) + r"\s*=.*$", re.M)
    if not pat.search(s):
        return f"SKIPPED (no '{key}' line): {p}"
    p.write_text(pat.sub(lambda m: f"{m.group(1)}{key}{sep}{v}", s, count=1))
    return f"themed: {p}"


# --------------------------------------------------------------------------
# Per-application writers
# --------------------------------------------------------------------------
def apply(name, t=None):
    """Write the palette into every themed config.

    `t` is the resolved nine-colour palette. It is passed in rather than looked
    up here because `auto` has no static entry in THEMES -- see resolve_theme().
    Defaulting to a lookup keeps any older call site working.
    """
    if t is None:
        t = THEMES[name]
    out = []

    # --- waybar --------------------------------------------------------
    out.append(
        patch_block(
            CFG / "waybar/style.css",
            f"""@define-color bar-bg {rgba(t["bg"], 0.94)};
@define-color panel-bg rgba(255, 255, 255, 0.07);
@define-color panel-hover rgba(255, 255, 255, 0.13);
@define-color text {rgba(t["text"], 0.92)};
@define-color muted {rgba(t["muted"], 0.62)};
@define-color mint {t["a1"]};
@define-color amber {t["a2"]};
@define-color coral {t["a3"]};
""",
        )
    )

    # --- wofi ----------------------------------------------------------
    out.append(
        patch_block(
            CFG / "wofi/style.css",
            f"""@define-color bga {rgba(t["bg"], 0.92)};
@define-color surface {t["surface"]};
@define-color surface2 {t["surface2"]};
@define-color border {t["border"]};
@define-color text {t["text"]};
@define-color text-bright {mix(t["text"], "#ffffff", 0.5)};
@define-color muted {t["muted"]};
@define-color a1 {t["a1"]};
@define-color a1-dim {mix(t["a1"], t["bg"], 0.55)};
""",
        )
    )

    # --- wlogout -------------------------------------------------------
    out.append(
        patch_block(
            CFG / "wlogout/style.css",
            f"""@define-color surface {t["surface"]};
@define-color surface2 {t["surface2"]};
@define-color surface-active {mix(t["a1"], t["bg"], 0.82)};
@define-color border rgba(255, 255, 255, 0.10);
@define-color text {rgba(t["text"], 0.88)};
@define-color text-bright {mix(t["text"], "#ffffff", 0.5)};
@define-color a1 {t["a1"]};
@define-color a2 {t["a2"]};
@define-color a3 {t["a3"]};
""",
        )
    )

    # --- mako ----------------------------------------------------------
    out.append(
        patch_block(
            CFG / "mako/config",
            f"""background-color=#{hexa(t["bg"], 240)}
text-color={t["text"]}
border-color={t["a1"]}
""",
        )
    )
    out.append(
        patch_block(
            CFG / "mako/config",
            f"border-color={t['a3']}\n",
            "THEME:CRITICAL:START",
            "THEME:CRITICAL:END",
        )
    )

    # --- hyprland border gradient --------------------------------------
    out.append(
        patch_block(
            CFG / "hypr/looknfeel.lua",
            f"""-- Window border colours. The active border is a 45-degree gradient between the
-- two accents; the inactive one is a near-background tone so unfocused windows
-- recede. Alpha is the last byte of each rgba() literal.
local theme = {{
    border_active_1 = "rgba({hexa(t["a1"], 238)})",
    border_active_2 = "rgba({hexa(t["a2"], 170)})",
    border_inactive = "rgba({hexa(t["surface2"], 136)})",
}}
""",
        )
    )

    # --- tmux ----------------------------------------------------------
    out.append(
        patch_block(
            TMUX_CONF,
            f"""set -g status-style "bg={t["surface"]},fg={t["text"]}"
setw -g window-status-style "fg={t["muted"]}"
setw -g window-status-current-style "bg={t["a1"]},fg={t["bg"]},bold"
set -g pane-border-style "fg={t["border"]}"
set -g pane-active-border-style "fg={t["a1"]}"
set -g message-style "bg={t["a1"]},fg={t["bg"]}"
set -g message-command-style "bg={t["a2"]},fg={t["bg"]}"
set -g mode-style "bg={t["surface2"]},fg={t["text"]}"
set -g display-panes-active-colour "{t["a1"]}"
set -g display-panes-colour "{t["muted"]}"
setw -g clock-mode-colour "{t["a1"]}"
""",
        )
    )

    # --- ghostty / bat / btop (single-line settings) --------------------
    out.append(patch_key(CFG / "ghostty/config", "theme", t["ghostty"]))

    bat_cfg = CFG / "bat/config"
    bat_cfg.parent.mkdir(parents=True, exist_ok=True)
    bat_cfg.write_text(
        "# Generated by ~/.local/bin/theme-switch — `just theme <name>` rewrites it.\n"
        "#\n"
        '# "ansi" means: use the terminal\'s own 16 colours, so bat inherits\n'
        "# whatever ghostty theme is active and always matches. Named themes give\n"
        "# finer-grained syntax colours where bat ships one.\n"
        "# List them with:  bat --list-themes\n"
        f'--theme="{t["bat"]}"\n'
        "\n"
        "# Show line numbers and git modification markers, but no heavy box drawing.\n"
        '--style="numbers,changes,header"\n'
    )
    out.append(f"themed: {bat_cfg}")

    out.append(
        patch_key(
            CFG / "btop/btop.conf",
            "color_theme",
            f"/usr/share/btop/themes/{t['btop']}.theme",
            quote=True,
        )
    )

    # --- quickshell ----------------------------------------------------
    # The desktop shell. Unlike every other target here this is not a patched
    # block inside a config the user also edits -- it is a generated file the
    # shell reads and nothing else writes, so it is emitted whole.
    #
    # Quickshell watches it (watchChanges in services/Theme.qml) and repaints
    # live, so there is nothing to reload in reload_all(). Written even when
    # Quickshell is not installed or not running: the directory is cheap, and
    # the file being there means the shell is correctly themed the first time
    # it ever starts rather than one theme switch later.
    try:
        QS_THEME.parent.mkdir(parents=True, exist_ok=True)
        QS_THEME.write_text(
            json.dumps(
                {
                    "name": name,
                    "desc": t.get("desc", ""),
                    "bg": t["bg"],
                    "surface": t["surface"],
                    "surface2": t["surface2"],
                    "border": t["border"],
                    "text": t["text"],
                    "muted": t["muted"],
                    "a1": t["a1"],
                    "a2": t["a2"],
                    "a3": t["a3"],
                },
                indent=2,
            )
            + "\n"
        )
        out.append(f"themed: {QS_THEME}")
    except OSError as e:
        out.append(f"SKIPPED (quickshell): {e}")

    # Keep the Settings GUI's swatch list in step with THEMES on every apply.
    out.append(write_catalogue())

    # --- GTK3 / GTK4 / the freedesktop portal, via matugen -------------
    # Everything above is a config file this script owns outright. These two
    # reach the applications it does not own -- toolkit apps through the GTK
    # CSS matugen writes, and Electron/Chromium/Flatpak through the colour
    # scheme the Settings portal broadcasts. See ~/.config/matugen/config.toml
    # and ~/.config/xdg-desktop-portal/hyprland-portal.conf.
    out.append(run_matugen_templates(name, t))
    out.append(gtk_colour_scheme(t))

    STATE.write_text(name + "\n")

    # Remember which named theme to fall back on when `auto` meets a greyscale
    # wallpaper. Only named themes qualify -- `auto` must never become its own
    # base, or the accents would drift a little further on every switch.
    if name != "auto":
        try:
            existing = json.loads(AUTO_STATE.read_text()) if AUTO_STATE.exists() else {}
        except (ValueError, OSError):
            existing = {}
        existing["base"] = name
        AUTO_STATE.write_text(json.dumps(existing, indent=2) + "\n")

    return out


def _running(name):
    return subprocess.run(["pgrep", "-x", name], capture_output=True).returncode == 0


def reload_all():
    """Push the new colours to everything that can reload without a restart.

    waybar is handled specially. It reloads on SIGUSR2, but it does not always
    survive one -- a reload arriving while it is still redrawing can take the
    process down, which is easy to hit when switching themes several times in
    a row. Losing the bar entirely is a much worse failure than a slow reload,
    so this checks afterwards and brings it back if the signal killed it.
    """
    if _running("waybar"):
        subprocess.run(
            ["killall", "-SIGUSR2", "waybar"], check=False, capture_output=True
        )
        time.sleep(1.0)

    if _running("waybar"):
        print("  reloaded waybar")
    else:
        subprocess.Popen(
            [
                "waybar",
                "-c",
                str(CFG / "waybar/config.jsonc"),
                "-s",
                str(CFG / "waybar/style.css"),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        time.sleep(1.5)
        print(
            "  restarted waybar"
            if _running("waybar")
            else "  WARNING: waybar is not running and could not be started"
        )

    for label, cmd in (
        ("mako", ["makoctl", "reload"]),
        ("hyprland", ["hyprctl", "reload"]),
    ):
        try:
            subprocess.run(cmd, check=False, capture_output=True, timeout=10)
            print(f"  reloaded {label}")
        except Exception as e:  # noqa: BLE001
            print(f"  could not reload {label}: {e}")

    # tmux: re-sourcing the config re-runs every `set -g`, which repaints all
    # attached sessions. `list-sessions` fails when no server is running, and
    # then there is nothing to repaint -- the next session reads the file
    # anyway. (Not `tmux info`: that needs an attached client, so it always
    # fails when run from a script like this one.)
    if subprocess.run(["tmux", "list-sessions"], capture_output=True).returncode == 0:
        r = subprocess.run(
            ["tmux", "source-file", str(TMUX_CONF)], capture_output=True, text=True
        )
        print(
            "  reloaded tmux"
            if r.returncode == 0
            else f"  could not reload tmux: {r.stderr.strip()}"
        )


# Every (file, start-marker) pair that apply() relies on. Kept next to the
# writers so a new themed block cannot be added without also being checkable.
REQUIRED_MARKERS = [
    ("waybar/style.css", "THEME:START"),
    ("wofi/style.css", "THEME:START"),
    ("wlogout/style.css", "THEME:START"),
    ("mako/config", "THEME:START"),
    ("mako/config", "THEME:CRITICAL:START"),
    ("hypr/looknfeel.lua", "THEME:START"),
    (str(TMUX_CONF), "THEME:START"),
]
REQUIRED_KEYS = [
    ("ghostty/config", "theme"),
    ("btop/btop.conf", "color_theme"),
]


def check():
    """Verify every marker and key the applier needs, without writing anything.

    This exists because a themed block that loses its marker fails *silently
    per file* -- apply() warns, but only if someone reads the output. Run this
    after editing any themed config.
    """
    bad = []
    for rel, marker in REQUIRED_MARKERS:
        p = CFG / rel
        if not p.exists():
            bad.append(f"missing file: {p}")
            continue
        s = p.read_text()
        # Must match exactly what patch_block() looks for: the marker AND the
        # "generated by" anchor on the same line.
        starts = [ln for ln in s.splitlines() if marker in ln and "generated by" in ln]
        end = marker.replace(":START", ":END")
        ends = [ln for ln in s.splitlines() if end in ln]
        if len(starts) != 1:
            bad.append(
                f"{rel}: found {len(starts)} usable '{marker}' lines "
                f"(need exactly 1, with 'generated by' on the same line)"
            )
        if len(ends) != 1:
            bad.append(f"{rel}: found {len(ends)} '{end}' lines (need exactly 1)")
    for rel, key in REQUIRED_KEYS:
        p = CFG / rel
        if not p.exists():
            bad.append(f"missing file: {p}")
        elif not re.search(r"^\s*" + re.escape(key) + r"\s*=", p.read_text(), re.M):
            bad.append(f"{rel}: no '{key} =' line")

    if bad:
        print("theme-switch check FAILED:")
        for b in bad:
            print("  " + b)
        return 1
    print(
        f"theme-switch check OK — {len(REQUIRED_MARKERS)} marker blocks, "
        f"{len(REQUIRED_KEYS)} keyed settings, all present."
    )
    return 0


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "--list"

    if arg in ("--check", "check"):
        return check()

    if arg in ("--list", "-l", "list", ""):
        cur = STATE.read_text().strip() if STATE.exists() else "(unknown)"
        print(f"Active theme: {cur}\n")
        print("Available themes:")
        for k, v in THEMES.items():
            print(f"  {k:<12} {v['desc']}")
        print(f"  {'auto':<12} derived from the current wallpaper, live")
        wallpaper = current_wallpaper()
        if wallpaper:
            print(f"               (currently: {wallpaper.name})")
        print("\nApply with:  just theme <name>")
        return 0

    # Regenerate ~/.config/quickshell/themes.json without applying anything.
    # The Settings GUI calls this if the file is missing.
    if arg in ("--catalogue", "--catalog"):
        print(write_catalogue())
        return 0

    # Read or change how matugen builds a scheme, then re-apply so the change
    # is visible now rather than at the next wallpaper change. The Quickshell
    # Settings UI drives exactly this entry point.
    #
    #     theme-switch --matugen                    show the current options
    #     theme-switch --matugen scheme-vibrant     pick an algorithm
    #     theme-switch --matugen light              or a mode
    #     theme-switch --matugen contrast 0.3       or a contrast offset (-1..1)
    #     theme-switch --matugen --json             machine-readable, for the GUI
    #
    # Arguments are matched by shape, not by position, so any combination in
    # any order works:  `--matugen light scheme-content contrast -0.2`.
    if arg in ("--matugen", "-M"):
        rest = sys.argv[2:]
        changes, i, bad = {}, 0, []
        while i < len(rest):
            a = rest[i]
            if a in MATUGEN_SCHEMES:
                changes["scheme"] = a
            elif "scheme-" + a in MATUGEN_SCHEMES:
                changes["scheme"] = "scheme-" + a
            elif a in ("dark", "light"):
                changes["mode"] = a
            elif a in MATUGEN_PREFER:
                changes["prefer"] = a
            elif a == "contrast" and i + 1 < len(rest):
                i += 1
                try:
                    changes["contrast"] = max(-1.0, min(1.0, float(rest[i])))
                except ValueError:
                    bad.append(rest[i])
            elif a in ("--json", "-j"):
                changes["__json__"] = True
            else:
                bad.append(a)
            i += 1
        if bad:
            print("Unrecognised: " + ", ".join(bad), file=sys.stderr)
            print("Schemes: " + ", ".join(MATUGEN_SCHEMES), file=sys.stderr)
            return 1

        as_json = changes.pop("__json__", False)
        opts = save_matugen_options(**changes) if changes else matugen_options()

        if as_json:
            print(json.dumps({
                "installed": matugen_available(),
                "options": opts,
                "schemes": [{"id": k, "desc": v} for k, v in MATUGEN_SCHEMES.items()],
                "prefer": [{"id": k, "desc": v} for k, v in MATUGEN_PREFER.items()],
            }, indent=2))
            return 0

        if not matugen_available():
            print("matugen is NOT installed -- `auto` is using the built-in")
            print("fallback derivation. Install it: just theme-install-matugen\n")
        print(f"  scheme    {opts['scheme']}  ({MATUGEN_SCHEMES[opts['scheme']]})")
        print(f"  mode      {opts['mode']}")
        print(f"  contrast  {opts['contrast']:+.2f}")
        print(f"  prefer    {opts['prefer']}  ({MATUGEN_PREFER[opts['prefer']]})")
        if not changes:
            print("\nSchemes:")
            for k, v in MATUGEN_SCHEMES.items():
                print(f"  {k.removeprefix('scheme-'):<12} {v}")
            print("\nSeed preference (which colour in the image to build from):")
            for k, v in MATUGEN_PREFER.items():
                print(f"  {k:<16} {v}")
            return 0

        # Something changed: re-apply whatever is active so it takes effect.
        active = STATE.read_text().strip() if STATE.exists() else "auto"
        print(f"\nRe-applying {active} with the new options...\n")
        sys.argv = [sys.argv[0], active]
        return main()

    if arg in ("--current", "-c"):
        print(STATE.read_text().strip() if STATE.exists() else "(unknown)")
        return 0

    # Preview what `auto` would derive, without applying it. The fast way to
    # decide whether a wallpaper is worth theming from:
    #     theme-switch --palette                 the current wallpaper
    #     theme-switch --palette ~/pic/foo.jpg   any image
    if arg in ("--palette", "-p"):
        image = Path(sys.argv[2]).expanduser() if len(sys.argv) > 2 else current_wallpaper()
        if image is None or not image.exists():
            print("No image. Pass one, or set a wallpaper first.", file=sys.stderr)
            return 1
        base = STATE.read_text().strip() if STATE.exists() else "mint"
        palette, notes = palette_from_wallpaper(image, base_theme=base if base in THEMES else "mint")
        print(f"\nPalette derived from: {image}\n")
        for line in notes:
            print(f"  {line}")
        print()
        for key in ("bg", "surface", "surface2", "border", "text", "muted", "a1", "a2", "a3"):
            # A block of the colour itself, so the palette can be judged by eye
            # in the terminal rather than by reading hex.
            r, g, b = (int(palette[key].lstrip("#")[i : i + 2], 16) for i in (0, 2, 4))
            print(f"  {key:<9} {palette[key]}  \x1b[48;2;{r};{g};{b}m      \x1b[0m")
        print(f"\nApply with:  just theme auto")
        return 0

    if arg != "auto" and arg not in THEMES:
        print(f"Unknown theme: {arg}\n", file=sys.stderr)
        print("Available: " + ", ".join(THEMES) + ", auto", file=sys.stderr)
        return 1

    # Verify the markers BEFORE touching anything, so a broken config is
    # reported up front instead of leaving a half-applied theme behind.
    if check() != 0:
        print("\nRefusing to apply a theme while a marker is missing.", file=sys.stderr)
        return 1

    # Resolve BEFORE printing the banner: `auto` reads the wallpaper here, and
    # a missing or unreadable image should fail before anything is written.
    palette, notes = resolve_theme(arg)

    print(f"\nApplying theme: {arg} — {palette.get('desc', '')}\n")
    for line in notes:
        print(f"  {line}")
    if notes:
        print()

    problems = []
    for line in apply(arg, palette):
        print("  " + line)
        if line.startswith("SKIPPED"):
            problems.append(line)
    print()
    reload_all()

    print(f"\nDone. Active theme: {arg}")
    print("Ghostty does not hot-reload the theme: press Ctrl+Shift+, in an open")
    print("window, or open a new one. btop picks it up on next launch.")
    if problems:
        print("\nWarnings:")
        for p in problems:
            print("  " + p)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

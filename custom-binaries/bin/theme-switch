#!/usr/bin/env python3
"""
theme-switch — retheme the whole desktop in one step.

Usage:
    theme-switch <name>     apply a theme everywhere
    theme-switch --list     show available themes
    theme-switch --current  show the active theme

Normally driven by the Justfile:  just theme <name>

WHAT IT TOUCHES
    ~/.config/ghostty/config        terminal colours
    ~/.config/bat/config            `bat` syntax highlighting
    ~/.config/btop/btop.conf        system monitor
    ~/.config/waybar/style.css      status bar
    ~/.config/wofi/style.css        launcher
    ~/.config/wlogout/style.css     power menu
    ~/.config/mako/config           notifications
    ~/.config/hypr/looknfeel.lua    window border gradient
    ~/.tmux.conf                    status bar, pane borders, messages

HOW IT IS SAFE
    Every file has a block delimited by THEME:START / THEME:END markers. Only
    the inside of that block is ever rewritten; everything else -- your layout,
    padding, comments, keybindings -- is untouched. If a marker is missing the
    file is skipped with a warning rather than being guessed at.

    ghostty/bat/btop are single-line settings rather than blocks, so those are
    matched by key name.

ADDING A THEME
    Add an entry to THEMES below. The nine core colours are all that is
    required; every derived shade (translucent bar background, dimmed accent,
    border alpha) is computed from them, so themes stay internally consistent.
"""

import colorsys
import json
import os
import re
import sys
import shutil
import subprocess
import time
from pathlib import Path

HOME = Path.home()
CFG = HOME / ".config"
STATE = CFG / "current-theme"
# The one themed file outside ~/.config. An absolute path is fine in
# REQUIRED_MARKERS below: `CFG / <absolute path>` yields the absolute path.
TMUX_CONF = HOME / ".tmux.conf"

# Quickshell reads its colours from this file and repaints live when it
# changes. See ~/.config/quickshell/services/Theme.qml -- that file is a
# consumer of this one, never a second source of colours.
QS_THEME = CFG / "quickshell/theme.json"

# Where the wallpaper path lives. Shared with hyprpaper and hyprlock; see the
# header of that file. `theme-switch auto` derives a palette from whatever
# image it points at.
WALLPAPER_CONF = CFG / "hypr/wallpaper.conf"

# Records what `auto` last derived, so the Settings GUI can show which image a
# palette came from and so a re-apply is reproducible without re-reading the
# image. Not the source of truth for the active theme -- STATE still is.
AUTO_STATE = CFG / "current-theme-auto.json"


#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: quickshell-migration-restore <archive.tar.gz>"
  exit 1
fi

ARCHIVE="$1"
if [[ ! -f "${ARCHIVE}" ]]; then
  echo "Archive not found: ${ARCHIVE}" >&2
  exit 1
fi

tar -xzf "${ARCHIVE}" -C "${HOME}"
echo "Restored: ${ARCHIVE}"

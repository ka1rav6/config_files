#!/usr/bin/env bash
# =============================================================================
# lock-session — lock the screen, and never leave you stranded doing it.
# =============================================================================
# Called from SUPER + ESCAPE (~/.config/hypr/bindings.lua).
#
# ORDER OF PREFERENCE
#   1. The Quickshell lock screen, but ONLY if Settings.features.lockScreen is
#      true. It runs as its OWN quickshell process, not inside the shell.
#   2. hyprlock, otherwise -- and hyprlock is also what hypridle calls for idle
#      and sleep locking, so that path never depends on the shell.
#
# -----------------------------------------------------------------------------
# THE RECOVERY PATH -- THIS IS THE POINT OF THE SCRIPT
#
# ext-session-lock keeps the session locked if the lock client dies. That is
# correct (a lock that fails open is not a lock) but it means a crashed locker
# used to mean a TTY. That happened once, for real, and this is the answer:
#
#   * The lock writes $XDG_RUNTIME_DIR/qs-lock-clean when it unlocks properly.
#   * This script waits for the lock process and then checks for that marker.
#   * No marker means it died. hyprlock is started immediately, and because
#     misc:allow_session_lock_restore is set at login (autostart.lua) it can
#     take over the lock the dead process left behind.
#
# So a crash now looks like "hyprlock appeared" instead of "reboot".
#
# The retry loop matters as much as the marker: if hyprlock itself fails to
# come up, this keeps trying rather than exiting and leaving a blank locked
# screen with nothing running on it.
# -----------------------------------------------------------------------------
#
# ONE LOCKER AT A TIME -- THE flock IS LOAD-BEARING
#
# hypridle's 300 s listener runs `loginctl lock-session`, and its lock_cmd is
# this script. But locking by hand with SUPER+ESCAPE does NOT set logind's
# LockedHint, so logind still considers the session unlocked and WILL fire that
# listener five minutes later -- re-entering this script while a locker is
# already holding the session.
#
# The old `pidof hyprlock` test did not catch that, because the locker holding
# the session was Quickshell, not hyprlock. The second invocation then:
#
#   1. deleted $MARKER (the clean-unlock marker),
#   2. ran `quickshell -n`, which EXITS 0 when a duplicate is already running
#      (it does not fail -- verified), so
#   3. `wait` returned success with no marker present, which this script reads
#      as "the locker crashed", and it launched hyprlock on top.
#
# Worse orderings existed: if step 1 landed just after a legitimate unlock had
# written the marker, the FIRST invocation then read a clean unlock as a crash
# and re-locked an unlocked desktop.
#
# The flock below makes all of that unreachable: a second invocation cannot
# get past it, so it touches no marker and starts no locker. It covers every
# entry point -- keybind, hypridle, loginctl, wlogout -- without having to
# recognise which locker is in use.
#
# `9>&-` on every long-lived child keeps that lock from being inherited. A
# locker holding this fd would keep the lock after we exited, permanently
# wedging every later attempt -- the same bug relayer.sh already carries a
# warning about.
# -----------------------------------------------------------------------------
set -uo pipefail

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
LOCKFILE="$RUNTIME/lock-session.lock"

# See the header. Exit quietly -- being asked to lock an already-locked session
# is normal, not an error.
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    exit 0
fi

SETTINGS="$HOME/.config/quickshell/settings.json"
LOCK_QML="$HOME/.config/quickshell/lock.qml"
MARKER="$RUNTIME/qs-lock-clean"

start_hyprlock() {
    # Up to five attempts. A locked session with no locker on it is the one
    # state this script must never exit in.
    for _ in 1 2 3 4 5; do
        pidof hyprlock >/dev/null 2>&1 && return 0
        hyprlock "$@" >/dev/null 2>&1 9>&- &
        sleep 1
        pidof hyprlock >/dev/null 2>&1 && { wait; return 0; }
    done
    # Everything failed. Say so somewhere it might be seen.
    notify-send -u critical "Lock screen" \
        "No locker could be started. Run 'hyprlock' from a TTY." 2>/dev/null
    return 1
}

# Already locked by hyprlock? Do not stack a second locker on the first.
if pidof hyprlock >/dev/null 2>&1; then
    exit 0
fi

enabled=$(python3 - "$SETTINGS" <<'PY' 2>/dev/null
import json, sys
try:
    with open(sys.argv[1]) as f:
        print("1" if json.load(f).get("features", {}).get("lockScreen") else "0")
except Exception:
    print("0")
PY
)

if [ "${enabled:-0}" != "1" ] || [ ! -f "$LOCK_QML" ] || ! command -v quickshell >/dev/null 2>&1; then
    start_hyprlock --grace 5
    exit $?
fi

rm -f "$MARKER"

# -n: no daemonising, so this script genuinely owns the process and `wait`
# means what it says.
quickshell -n -p "$LOCK_QML" >/dev/null 2>&1 9>&- &
lock_pid=$!

# If this script is killed, do not leave the locker orphaned holding the
# session -- hand over to hyprlock instead.
trap 'kill "$lock_pid" 2>/dev/null; start_hyprlock' INT TERM

wait "$lock_pid"
status=$?

if [ -f "$MARKER" ]; then
    rm -f "$MARKER"
    exit 0
fi

# No marker: it died holding the lock.
echo "lock-session: Quickshell locker exited ($status) without unlocking; starting hyprlock" >&2
start_hyprlock

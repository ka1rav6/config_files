#!/usr/bin/env python3

import os
import sys
import shutil
import subprocess
import json
from datetime import datetime
from pathlib import Path

# Configuration
HOME_DIR = Path.home()
BACKUP_DIR = HOME_DIR / "dotfiles"
BACKUP_CONFIG_FILE = BACKUP_DIR / "backup_paths.json"

# Default paths to backup (organized by category)
DEFAULT_BACKUP_PATHS = [
    {
        "path": HOME_DIR / ".zshrc",
        "category": "shell",
        "description": "Zsh shell configuration"
    },
    {
        "path": HOME_DIR / ".bashrc",
        "category": "shell",
        "description": "Bash shell configuration"
    },
    {
        "path": HOME_DIR / ".profile",
        "category": "shell",
        "description": "Profile configuration"
    },
    {
        "path": HOME_DIR / ".gitconfig",
        "category": "shell",
        "description": "Git configuration"
    },
    {
        "path": HOME_DIR / ".tmux.conf",
        "category": "shell",
        "description": "TMUX configuration"
    },
    {
        "path": HOME_DIR / ".vimrc",
        "category": "shell",
        "description": "Vim configuration"
    },
    {
        "path": HOME_DIR / ".config/ghostty",
        "category": "terminals",
        "description": "Ghostty terminal emulator config"
    },
    {
        "path": HOME_DIR / ".config/hypr",
        "category": "window-manager",
        "description": "Hyprland window manager config"
    },
    {
        "path": HOME_DIR / ".config/waybar",
        "category": "status-bars",
        "description": "Waybar status bar config"
    },
    {
        "path": HOME_DIR / ".config/wofi",
        "category": "status-bars",
        "description": "Wofi launcher config"
    },
    {
        "path": HOME_DIR / ".config/nvim",
        "category": "editors",

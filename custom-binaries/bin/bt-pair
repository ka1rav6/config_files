#!/usr/bin/env bash
# =============================================================================
# bt-pair — pair a new Bluetooth device, with a GUI, without a resident applet.
# =============================================================================
# Called from the Control Center's Bluetooth page.
#
# THE PROBLEM THIS SOLVES
#   BlueZ will not pair with anything unless something has registered an
#   org.bluez.Agent1 -- the object that answers "confirm this passkey" and
#   "enter this PIN". Connecting an ALREADY-paired device needs no agent, which
#   is why headphones keep reconnecting fine without one; pairing a NEW device
#   fails outright.
#
#   Quickshell's Bluetooth module drives the adapter but registers no agent, and
#   in blueman the agent lives specifically in blueman-applet
#   (blueman/plugins/applet/AuthAgent.py) -- blueman-manager on its own cannot
#   pair. So the applet used to be started at login and sat there holding
#   ~125 MiB of Python to be ready for something done a few times a year.
#
# WHAT THIS DOES INSTEAD
#   Starts the applet only for the length of a pairing session, opens the
#   manager window, and stops the applet again when that window closes -- but
#   only if this script was the one that started it. Idle cost: nothing.
#
#   Everything else about Bluetooth stays where it is: the Control Center
#   toggles the adapter, lists devices, connects and disconnects, and
#   services/Bluetooth.qml still selects the A2DP profile on connect.
# -----------------------------------------------------------------------------
set -uo pipefail

if ! command -v blueman-manager >/dev/null 2>&1; then
    notify-send "Bluetooth" "blueman-manager is not installed." 2>/dev/null
    exit 1
fi

started_applet=0
if ! pgrep -x blueman-applet >/dev/null 2>&1; then
    blueman-applet >/dev/null 2>&1 &
    started_applet=1
    # The agent registers a moment after the process starts; opening the
    # manager before that races and the first pair attempt fails.
    for _ in $(seq 1 20); do
        busctl --system call org.bluez /org/bluez org.freedesktop.DBus.Introspectable Introspect >/dev/null 2>&1 && break
        sleep 0.1
    done
    sleep 0.4
fi

blueman-manager >/dev/null 2>&1

# Only clean up what we created. If the applet was already running -- because
# it was started by hand, or put back into autostart -- leave it alone.
if [ "$started_applet" = "1" ]; then
    pkill -x blueman-applet >/dev/null 2>&1
fi

#!/usr/bin/env bash
# =============================================================================
# hyprland-share-picker, restyled.
# =============================================================================
# xdg-desktop-portal-hyprland launches this instead of the bare picker, because
# ~/.config/hypr/xdph.conf sets:
#
#     screencopy { custom_picker_binary = ~/.local/bin/hyprland-share-picker-themed }
#
# All this does is add QApplication's built-in -stylesheet argument and hand
# every other argument straight through. The picker itself is untouched: it is
# the security boundary for screen capture -- what it prints on stdout is what
# gets shared -- and its window list arrives in XDPH_WINDOW_SHARING_LIST, which
# `exec` preserves along with the rest of the environment.
#
# WHY exec AND NOT A PLAIN CALL
#   xdph reads the picker's stdout and waits for it to exit. exec replaces this
#   shell with the picker rather than adding a parent process between the two,
#   so the exit status and the pipe are the picker's own.
#
# THE STYLESHEET MAY NOT EXIST
#   It is generated by `theme-switch` through matugen. On a fresh machine, or
#   between `just restore` and the next `just theme`, it will not be there yet.
#   Falling back to the unstyled picker is correct: an ugly dialog is a working
#   dialog, and screen sharing must not depend on the theme system.
# =============================================================================

REAL=/usr/bin/hyprland-share-picker
QSS="${XDG_CONFIG_HOME:-$HOME/.config}/hyprland-share-picker/style.qss"

if [ -r "$QSS" ]; then
    exec "$REAL" -stylesheet "$QSS" "$@"
fi

exec "$REAL" "$@"

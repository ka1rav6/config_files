$terminal = ghostty
# Set the Super/Windows key as mainMod
$mainMod = SUPER

monitor = , preferred, auto, 1

input {
    kb_layout = us
    kb_options = caps:swapescape
    follow_mouse = 1
    scroll_factor = 1.0
    sensitivity = 0.3
    natural_scroll = false
    touchpad {
        natural_scroll = true
        scroll_factor = 1.0
    }
}

general {
    gaps_in = 5
    gaps_out = 10
    border_size = 2

    layout = dwindle
}

decoration {
    rounding = 8
}
animations {
    enabled = true

    bezier = easeOut, 0.16, 1, 0.3, 1

    animation = windows, 1, 5, easeOut
    animation = windowsOut, 1, 4, easeOut
    animation = border, 1, 5, default
    animation = fade, 1, 4, default
    animation = workspaces, 1, 5, easeOut
}
cursor { 
    no_hardware_cursors = true
}
misc {
    disable_hyprland_logo = false
    disable_splash_rendering = false
}
exec-once = hyprpaper
exec-once = waybar
exec-once = ~/.config/hypr/scripts/start-dock.sh
exec-once = systemctl --user start hyprpolkitagent.service 2>/dev/null || true
exec-once = nm-applet --indicator
exec-once = blueman-applet



monitor = eDP-1, 2880x1800@120, auto, 1.5

bind = SUPER, RETURN, exec, $terminal
bind = SUPER, Q, killactive
bind = SUPER, M, exit

bind = SUPER, LEFT, movefocus, l
bind = SUPER, DOWN, movefocus, d
bind = SUPER, UP, movefocus, u
bind = SUPER, RIGHT, movefocus, r
bind = SUPER, L, exec, hyprlock

bind = SUPER, 1, workspace, 1
bind = SUPER, 2, workspace, 2
bind = SUPER, 3, workspace, 3
bind = SUPER, 4, workspace, 4

bind = SUPER SHIFT, 1, movetoworkspace, 1
bind = SUPER SHIFT, 2, movetoworkspace, 2
bind = SUPER SHIFT, 3, movetoworkspace, 3
bind = SUPER SHIFT, 4, movetoworkspace, 4
bindel = , XF86MonBrightnessDown, exec, brightnessctl set 10%-
bindel = , XF86MonBrightnessUp, exec, brightnessctl set 10%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindl = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPrev, exec, playerctl previous

bind = , Print, exec, grim -g "$(slurp)" - | wl-copy
bind = $mainMod, Print, exec, grim -g "$(slurp)" ~/Pictures/Screenshot_$(date +'%Y%m%d_%H%M%S').png
bind = $mainMod SHIFT, Print, exec, grim - | wl-copy
# ============================================================
# APPLICATION / DESKTOP BINDINGS
# ============================================================
# Super + D -> show desktop
bind = $mainMod, D, exec, hyprctl dispatch togglespecialworkspace desktop
# Super + S -> launcher/drawer
bind = $mainMod, S, exec, nwg-drawer -wm hyprland
# Super + E -> Nautilus
bind = $mainMod, E, exec, nautilus
# Super + C -> Chrome
bind = $mainMod, C, exec, google-chrome --new-window
# Super + V -> VS Code
bind = $mainMod, V, exec, code
# Super + Shift + A -> minimize current window
bind = $mainMod SHIFT, A, exec, ~/.config/hypr/scripts/minimize-window.sh
# Super + Shift + B -> restore oldest minimized window
bind = $mainMod SHIFT, B, exec, ~/.config/hypr/scripts/restore-window.sh

# Super + F -> toggle fullscreen
bind = $mainMod, F, fullscreen, 0
# Move window around with Super + Shift + H/J/K/L
bind = $mainMod SHIFT, H, movewindow, l
bind = $mainMod SHIFT, J, movewindow, d
bind = $mainMod SHIFT, K, movewindow, u
bind = $mainMod SHIFT, L, movewindow, r
# Resize window with Super + Ctrl + H/J/K/L
binde = $mainMod CTRL, H, resizeactive, -50 0
binde = $mainMod CTRL, J, resizeactive, 0 50
binde = $mainMod CTRL, K, resizeactive, 0 -50
binde = $mainMod CTRL, L, resizeactive, 50 0
# Move focused window to workspace 1-4
bind = SUPER SHIFT, 1, movetoworkspacesilent, 1
bind = SUPER SHIFT, 2, movetoworkspacesilent, 2
bind = SUPER SHIFT, 3, movetoworkspacesilent, 3
bind = SUPER SHIFT, 4, movetoworkspacesilent, 4
# Toggle floating
bind = $mainMod SHIFT, SPACE, togglefloating

# Center floating window
bind = $mainMod SHIFT, C, centerwindow

# Super by itself -> same as Super + S
bindr = $mainMod, SUPER_L, exec, nwg-drawer -wm hyprland

debug { 
    disable_logs = false
    enable_stdout_logs = true 
}


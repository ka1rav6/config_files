# =============================================================================
# Ghostty — terminal emulator
# =============================================================================
# Ghostty is a GPU-accelerated terminal written in Zig. It renders through
# OpenGL and runs natively on Wayland, which is why it is the terminal wired
# into the Hyprland config (`terminal = "ghostty"` in ~/.config/hypr/defaults.lua).
#
# Syntax: one `key = value` per line, `#` starts a comment. No quotes needed
# except where a value contains spaces.
#
# Full option list:  ghostty +show-config --default --docs
# Reload after editing: the config is re-read on launch; open a new window, or
# press Ctrl+Shift+, to reload in place.
# -----------------------------------------------------------------------------


# --- Font --------------------------------------------------------------------
# A Nerd Font is required, not optional, for this setup: waybar, yazi, btop and
# the wlogout menu all draw glyphs from the Nerd Font private-use range. A plain
# JetBrains Mono renders those as empty boxes.
font-family = "JetBrainsMono Nerd Font"
font-size = 13


# --- Theme -------------------------------------------------------------------
# Named theme from Ghostty's built-in collection. List them all with:
#     ghostty +list-themes
# Preview one without editing this file:
#     ghostty --theme=<name>
theme = Gruvbox Dark


# --- Transparency ------------------------------------------------------------
# 0.0 fully transparent, 1.0 fully opaque. 0.65 lets the wallpaper show through.
#
# This one value is the reason blur is enabled at all in the compositor.
# ~/.config/hypr/looknfeel.lua turns blur on, and ~/.config/hypr/rules.lua then
# marks every *other* window `no_blur` — blurring behind an opaque window is
# pure cost with nothing visible to show for it. If you ever set this back to
# 1.0, turn blur off in looknfeel.lua at the same time; leaving it on would be
# paying the compositor's most expensive effect for no visual result.
background-opacity = 0.65


# --- Window padding ----------------------------------------------------------
# Breathing room in pixels between the window edge and the first cell, so text
# does not sit flush against the rounded border Hyprland draws (rounding = 8).
window-padding-x = 6
window-padding-y = 6


# --- Selection behaviour -----------------------------------------------------
# false: selecting text does NOT copy it automatically. Copy explicitly with
# Ctrl+Shift+C. Middle-click paste of the X11 primary selection still works.
# Set to true if you prefer the traditional Unix select-to-copy behaviour.
copy-on-select = true


# --- Close confirmation ------------------------------------------------------
# false: closing a window or tab with a running process does not prompt.
# Faster, at the cost of the safety net — a stray Ctrl+Shift+W will take a
# long-running build with it. Set to true to get the confirmation dialog back.
confirm-close-surface = false


# --- Startup speed -----------------------------------------------------------
# THE single biggest win for how fast a new terminal appears.
#
# The default is `detect`, which enables single-instance only when Ghostty is
# launched from its .desktop file. Your terminals are launched from Hyprland
# keybindings (`terminal = "ghostty"` in ~/.config/hypr/defaults.lua), which is
# a plain exec — so under `detect` every SUPER+Return paid for a full cold
# start: snap mount, GPU/OpenGL init, and font discovery, every single time.
#
# With this set to `true`, a new window is an IPC message to the Ghostty process
# that is already running, and appears essentially instantly. Measured: opening
# a fourth window added zero new processes.
#
# Why this is safe for the scratchpads, which is the thing to worry about:
#   * Windows launched with a distinct --class (the scratchpad terminal in
#     ~/.config/hypr/scratchpads.lua) still get their OWN process and keep that
#     class — verified directly. The class is part of the instance identity, so
#     they form separate instance groups and the window rules keep matching.
#   * Windows launched with -e (the yazi scratchpad, the tiled file browser)
#     have single-instance force-disabled by Ghostty itself, precisely so CLI
#     arguments are honoured.
#
# If you ever see a new window inherit the wrong working directory or class,
# this is the setting to suspect — set it back to `detect`.
gtk-single-instance = true

# Ghostty was installed as a *snap*, and that cost far more than the 130 ms this
# note used to claim. Measured end to end — launch to a shell actually running,
# where `zsh -i` on its own exits in 0.11 s:
#
#     snap, cold start                       0.83 s
#     snap, "attaching" to a live instance   0.51 s
#     +new-window over D-Bus                 0.18 s
#
# WHERE IT WENT — and why the old claim here was wrong:
#   * 0.27 s was GTK walking the 8 icon themes the snap bundles: 586
#     directories, 5822 files, and not one icon-theme.cache, against a 142 MB
#     squashfs mounted `threads=single` where every miss costs a decompress.
#     7359 filesystem operations per launch, all of them duplicating themes
#     that already sit cached on ext4 in /usr/share/icons.
#   * 0.15 s was `snap run` itself — snap-confine and seccomp, which do nothing
#     for a CLASSIC snap that already runs unconfined.
#   * single-instance does NOT hide either one, which is where the old note went
#     wrong. The second window still does full GTK, fontconfig and GL init
#     BEFORE it discovers the running instance over D-Bus and hands off: 0.57 s
#     cold versus 0.51 s attaching, a 0.06 s saving rather than the whole cold
#     start. `ghostty +new-window` is the actual fast path — it makes the D-Bus
#     call and exits without touching GTK at all.
#
# A native install removes the first two outright. ~/.local/bin/ghostty removes
# the third by routing launches through +new-window whenever an instance is up,
# and autostart.lua keeps one up from login. See the comments in both.

# Keep that instance alive when no windows are open.
#
# The default is `true`, and it is why terminals felt slow at random rather than
# consistently: closing your LAST window quit the instance, so the next terminal
# paid a full cold start again. Prewarming is pointless without this — the
# daemon autostart.lua starts would die the first time you closed a window.
#
# The scratchpads read this same file and are meant to persist anyway, so this
# changes nothing for them.
quit-after-last-window-closed = false

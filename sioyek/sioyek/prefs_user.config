# ─────────────────────────────────────────
# Sioyek — Hyprland Dark Theme
# ─────────────────────────────────────────

# Background outside PDF pages
dark_mode_background_color    0.055 0.055 0.070

# Don't make PDF text pure white
dark_mode_contrast             0.82

# PDF page colors when using custom color mode
custom_background_color        0.055 0.055 0.070
custom_text_color              0.88 0.88 0.90

# Sioyek UI
ui_background_color            0.075 0.075 0.095
ui_text_color                  0.82 0.82 0.86

# Selected UI item
ui_selected_background_color   0.14 0.14 0.18
ui_selected_text_color         0.95 0.95 0.98

# Text selection
text_highlight_color           0.35 0.55 1.0

# Search matches
search_highlight_color         0.35 0.55 1.0

# Visual mark
visual_mark_color              0.35 0.55 1.0 0.15

# Use dark mode automatically
startup_commands               toggle_dark_mode

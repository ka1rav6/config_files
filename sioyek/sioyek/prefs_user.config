# ═══════════════════════════════════════════════════════════════════════
#  sioyek — preferences
#  ~/.config/sioyek/prefs_user.config
#
#  Keybindings live in  ~/.config/sioyek/keys_user.config
#  Press <C-h> in sioyek for the full cheatsheet, or : for the palette.
#  Colors are  R G B  floats in 0..1  (optionally a 4th alpha).
# ═══════════════════════════════════════════════════════════════════════


# ─── THEME: "midnight" ─────────────────────────────────────────────────
# Canvas behind the pages
background_color                0.97 0.97 0.97
dark_mode_background_color      0.047 0.051 0.063

# Dim the whites so inverted text isn't a flashlight to the face
dark_mode_contrast              0.82

# Page colors for toggle_custom_color (<S-F8>) — warm, sepia-ish dark
custom_background_color         0.129 0.137 0.169
custom_text_color               0.878 0.867 0.827

# Chrome: menus, prompts, TOC, file picker
ui_background_color             0.071 0.078 0.098
ui_text_color                   0.847 0.863 0.902
ui_selected_background_color    0.231 0.353 0.612
ui_selected_text_color          1.0 1.0 1.0

# Status bar
status_bar_color                0.071 0.078 0.098
status_bar_text_color           0.600 0.643 0.749

# Gap between pages
page_separator_width            2
page_separator_color            0.153 0.165 0.204

# Selection = blue, search hits = amber, so they never look alike
text_highlight_color            0.353 0.549 1.0
search_highlight_color          1.0 0.647 0.204
visual_mark_color               0.353 0.549 1.0 0.13
link_highlight_color            0.447 0.749 1.0
synctex_highlight_color         1.0 0.400 0.800


# ─── TYPOGRAPHY ────────────────────────────────────────────────────────
ui_font                         Inter
font_size                       17
status_bar_font_size            15


# ─── STARTUP ───────────────────────────────────────────────────────────
default_dark_mode               1
check_for_updates_on_startup    0
should_load_tutorial_when_no_other_file  0
should_launch_new_window        0
should_use_multiple_monitors    0


# ─── RENDERING ─────────────────────────────────────────────────────────
# Smooth scaling instead of nearest-neighbour — much nicer on HiDPI
linear_filter                   1
# Re-render the overview popup at full resolution instead of upscaling
rerender_overview               1
should_draw_unrendered_pages    0
prerender_next_page_presentation 1


# ─── MOVEMENT & ZOOM FEEL ──────────────────────────────────────────────
zoom_inc_factor                 1.15
vertical_move_amount            1.0
horizontal_move_amount          1.0
# <C-d>/<C-u> move this fraction of a screen — keeps context on screen
move_screen_ratio               0.5
wheel_zoom_on_cursor            1
touchpad_sensitivity            1.0
fit_to_page_width_ratio         0.80


# ─── VISUAL RULER (<C-v>) ──────────────────────────────────────────────
# Mask above *and* below the focused line
ruler_mode                      1
ruler_padding                   1.0
ruler_x_padding                 5.0
visual_mark_next_page_fraction  0.75
visual_mark_next_page_threshold 0.25


# ─── SEARCH ────────────────────────────────────────────────────────────
super_fast_search               1
case_sensitive_search           0


# ─── LISTS, TOC, MENUS ─────────────────────────────────────────────────
flat_toc                        0
collapsed_toc                   0
multiline_menus                 1
sort_bookmarks_by_location      1
show_doc_path                   0
# Build a TOC by heuristics for documents that ship without one
create_table_of_contents_if_not_exists  1
max_created_toc_size            5000


# ─── OVERVIEW POPUP ────────────────────────────────────────────────────
overview_size                   0.8 0.45
overview_offset                 0 0


# ─── MOUSE ─────────────────────────────────────────────────────────────
# ctrl+click peeks at the reference under the cursor; alt+click jumps to it
control_click_command           overview_under_cursor
alt_click_command               smart_jump_under_cursor
shift_click_command             visual_mark_under_cursor
highlight_middle_click          0


# ─── EXTERNAL SEARCH — select text, press s, then a letter ─────────────
search_url_a    https://arxiv.org/a/search?searchtype=all&query=
search_url_b    https://www.semanticscholar.org/search?q=
search_url_d    https://duckduckgo.com/?q=
search_url_g    https://www.google.com/search?q=
search_url_h    https://github.com/search?q=
search_url_l    https://libgen.is/scimag/?q=
search_url_o    https://www.wolframalpha.com/input?i=
search_url_s    https://scholar.google.com/scholar?q=
search_url_t    https://stackoverflow.com/search?q=
search_url_w    https://en.wikipedia.org/w/index.php?search=
search_url_x    https://en.wiktionary.org/w/index.php?search=

middle_click_search_engine          s
shift_middle_click_search_engine    x


# ─── CUSTOM COMMANDS — DISABLED ON THIS BUILD ─────────────────────────
# Ubuntu's sioyek 2.0.0 accepts `new_command` and will happily bind the name
# to a key, but it never spawns the process. Verified with a minimal probe:
# the binding registers, the key is delivered, nothing runs.
# The scripts themselves work — run them from a shell (see README).
# Uncomment this block if you ever move to an upstream build.

# <C-h> / <F1> — build (once) and open the cheatsheet PDF
#new_command _help /home/kairav/.config/sioyek/scripts/help.sh %{sioyek_path}

# Y — yank selection with PDF line-breaks + hyphenation repaired
#new_command _copy_clean /home/kairav/.config/sioyek/scripts/copy-clean.sh %{sioyek_path} "%{selected_text}"

# ge — export this document's highlights to Markdown, grouped by color
#new_command _export_highlights /home/kairav/.config/sioyek/scripts/export-highlights.py %{sioyek_path} "%{file_path}" %{local_database} %{shared_database}

# gc — copy a citation line:  "Title, p. 42"
#new_command _cite /home/kairav/.config/sioyek/scripts/cite.sh %{sioyek_path} "%{file_name}" %{page_number} "%{selected_text}"

# <C-S-b> — snapshot highlights/bookmarks/portals database
#new_command _backup /home/kairav/.config/sioyek/scripts/backup.sh %{sioyek_path} %{local_database} %{shared_database}

# gf — reveal the current document in the file manager
#new_command _reveal /home/kairav/.config/sioyek/scripts/reveal.sh %{sioyek_path} "%{file_path}"

# Rebuild the cheatsheet after you edit keys_user.config (also in : palette)
#new_command _rebuild_help /home/kairav/.config/sioyek/scripts/help.sh %{sioyek_path} --rebuild


# ─── LATEX INVERSE SEARCH ──────────────────────────────────────────────
# <F4> toggles synctex mode; right-click then jumps to the source line.
# Uncomment the line matching your editor:
#inverse_search_command  nvim --server /tmp/nvim.pipe --remote-send "<esc>:e\ %1<CR>:%2<CR>"
#inverse_search_command  code -r -g %1:%2


# ─── EXPERIMENTAL ──────────────────────────────────────────────────────
# Turns on in-progress features; flip to 1 if you like living dangerously
#enable_experimental_features   1

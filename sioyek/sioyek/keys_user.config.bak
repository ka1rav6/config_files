# ═══════════════════════════════════════════════════════════════════════
#  sioyek — vim keybindings
#  ~/.config/sioyek/keys_user.config
#
#  Press <C-h> (or <F1>) for the full visual cheatsheet.
#  Press :     for the fuzzy command palette (every command, searchable).
#
#  Syntax:  command        key
#           cmd1;cmd2      key      (chained)
#           <C-x> ctrl+x   <A-x> alt+x   <S-x> shift+x   gg = press g twice
#  Most motions accept a count prefix:  10j   150gg   3n
# ═══════════════════════════════════════════════════════════════════════


# ─── HELP ──────────────────────────────────────────────────────────────
#_help                               <C-h>
#_help                               <f1>
# Fuzzy palette of every built-in + custom command
command                             :
command                             <C-S-p>


# ─── MOTION (hjkl) ─────────────────────────────────────────────────────
# Scroll down / up (vertical_move_amount in prefs)
move_down                           j
# Scroll up
move_up                             k
# Pan right — sioyek's move_left slides the page itself leftwards
move_left                           l
# Pan left
move_right                          h

# Down half a screen, keeping context (move_screen_ratio in prefs)
screen_down                         <C-d>
# Up half a screen
screen_up                           <C-u>
screen_down                         <space>
screen_up                           <S-<space>>
# Forward / back one full page height
next_page                           <C-f>
previous_page                       <C-b>

# Document ends.  150gg jumps to page 150.
goto_beginning                      gg
goto_end                            G
goto_page_with_page_number          gp

# Line ends, ignoring white margins
goto_left_smart                     ^
goto_left_smart                     0
goto_right_smart                    $

# Top / bottom of the current page
goto_top_of_page                    zt
goto_bottom_of_page                 zb

# Two-column papers: jump to top-right of page
goto_top_of_page;goto_right_smart   zc

# Chapters (]] / [[ are impossible: the default keyfile owns `]`)
next_chapter                        gj
prev_chapter                        gk


# ─── JUMPLIST (vim <C-o> / <C-i>) ──────────────────────────────────────
# Back to where you jumped from
prev_state                          <C-o>
# Forward again along the jump history
next_state                          <C-i>
prev_state                          <backspace>
next_state                          <S-<backspace>>


# ─── SEARCH ────────────────────────────────────────────────────────────
# /foo          search whole document
# /<10,30>foo   search only pages 10-30
search                              /
regex_search                        ?
chapter_search                      g/
next_item                           n
previous_item                       N


# ─── ZOOM & FIT (z-prefix) ─────────────────────────────────────────────
# Zoom in / out around the centre of the window
zoom_in                             +
zoom_out                            -
# Zoom in / out around the mouse pointer instead
zoom_in_cursor                      zi
zoom_out_cursor                     zo
fit_to_page_width                   =
fit_to_page_width_smart             zz
fit_to_page_width                   zw
fit_to_page_width_smart             zW
fit_to_page_height                  zh
fit_to_page_height_smart            zH
fit_to_page_width_ratio             zr
rotate_clockwise                    r
rotate_counterclockwise             R


# ─── FILES & WINDOWS ───────────────────────────────────────────────────
open_document_embedded              o
open_document_embedded_from_current_path  gO
open_document                       <A-o>
open_prev_doc                       O
open_last_document                  g6
open_last_document                  <C-6>
new_window                          <C-t>
close_window                        <C-w>
goto_window                         gw
reload                              <C-r>
# Quit sioyek
quit                                q
quit                                ZZ


# ─── YANK / SELECT ─────────────────────────────────────────────────────
# Copy the selection verbatim
copy                                y
copy                                <C-c>
# Yank with PDF line-breaks and hyphenation cleaned up (great for quoting)
#_copy_clean                         Y
# Select text with the keyboard, vim-style
keyboard_select                     v
# Label every link on screen, jump by typing its label
open_link                           f
keyboard_smart_jump                 F
open_selected_url                   gx


# ─── MARKS  (m<a-z> to set, `<a-z> to jump) ────────────────────────────
set_mark                            m
goto_mark                           `
goto_mark                           '


# ─── BOOKMARKS ─────────────────────────────────────────────────────────
add_bookmark                        b
delete_bookmark                     db
goto_bookmark                       gb
goto_bookmark_g                     gB


# ─── HIGHLIGHTS  (select text, then h<a-z> picks the colour) ───────────
add_highlight                       H
add_highlight_with_current_type     <C-S-h>
set_select_highlight_type           gt
toggle_select_highlight             gT
delete_highlight                    dh
goto_highlight                      gh
goto_highlight_g                    gH
goto_next_highlight                 gnh
goto_prev_highlight                 gNh
# Bake highlights + bookmarks into a real PDF other readers can see
embed_annotations                   gE
# Export every highlight of this document to a Markdown file
#_export_highlights                  ge


# ─── PORTALS  (link two documents / two spots together) ────────────────
portal                              p
edit_portal                         P
goto_portal                         <tab>
delete_portal                       dp
toggle_window_configuration         <f12>
toggle_one_window                   <f3>


# ─── REFERENCES & FIGURES (visual-ruler mode) ──────────────────────────
# Peek at "Figure 2.1" / "[12]" without losing your place
overview_definition                 gl
goto_definition                     gd
goto_definition                     <C-]>
portal_to_definition                gD
keyboard_overview                   go
goto_overview                       gV
close_overview                      <esc>
close_overview                      gq
next_preview                        <C-n>
previous_preview                    <C-S-n>


# ─── VISUAL RULER (focus one line at a time) ───────────────────────────
toggle_visual_scroll                <C-v>
enter_visual_mark_mode              gv
move_visual_mark_down               <C-j>
move_visual_mark_up                 <C-k>
close_visual_mark                   <C-esc>
close_visual_mark                   gQ


# ─── APPEARANCE & MODES ────────────────────────────────────────────────
toggle_dark_mode                    <f8>
toggle_custom_color                 <S-<f8>>
toggle_presentation_mode            <f5>
toggle_fullscreen                   <f11>
toggle_statusbar                    <f2>
toggle_titlebar                     <S-<f2>>
toggle_highlight                    <A-h>
toggle_mouse_drag_mode              <f6>
toggle_horizontal_scroll_lock       <A-l>
toggle_fastread                     <A-f>


# ─── EXTERNAL SEARCH  (select text, then s<letter>) ────────────────────
# Letters are defined by search_url_* in prefs_user.config
external_search                     s


# ─── LATEX ─────────────────────────────────────────────────────────────
toggle_synctex                      <f4>
synctex_under_cursor                gs


# ─── CONFIG & DATA ─────────────────────────────────────────────────────
# Your own config files (plain-char sequences always parse)
prefs_user                          g,
prefs_user                          <C-,>
keys_user                           g.
keys_user                           <C-S-,>
# The shipped defaults are reachable from the : palette as `prefs` / `keys`
#_backup                             <C-S-b>
#_reveal                             gf
export                              gX
import                              gI


# ─── POWER TOOLS (undocumented but real — found in the 2.0.0 binary) ───
# Reload prefs + keys without restarting sioyek
reload_config                       <A-r>
# Momentum/smooth scrolling (on by default via startup_commands)
toggle_smooth_scroll_mode           <A-s>
toggle_scrollbar                    <A-b>
# Fix documents whose PDF page 1 isn't printed page 1, then N gg is honest
set_page_offset                     gU
# Select a rectangular region (figures, tables)
select_rect                         gr
# Re-centre the window on the current selection
goto_selected_text                  gz
# Turn the open overview popup into a permanent portal
overview_to_portal                  gP
overview_next_item                  <A-j>
overview_prev_item                  <A-k>
enter_password                      <A-p>
ranged_search                       g?

# Copy a citation ("Title, p. 42", plus the quote if text is selected)
#_cite                               gc
